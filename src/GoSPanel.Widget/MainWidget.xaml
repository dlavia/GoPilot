<Page
    x:Class="GoSPanel.Widget.MainWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:GoSPanel.Widget.Controls"
    Background="Transparent"
    XYFocusKeyboardNavigation="Enabled">

    <!-- Fondo transparente: se ve el de Game Bar. El contenido se amplía con una escala fija (ver OnScaleHostSizeChanged). -->
    <Grid x:Name="ScaleHost" Background="{StaticResource PageBrush}" SizeChanged="OnScaleHostSizeChanged">
    <Grid x:Name="LayoutRoot" Padding="10,8,10,10" RowSpacing="10" HorizontalAlignment="Left" VerticalAlignment="Top">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Una sola fila: pestañas (LT / RT; Game Bar se reserva LB / RB para cambiar de widget). El perfil
             está en el pie. Game Bar ya pone el título «GoPilot» encima
             y no se puede quitar: así se ahorra la fila que ocupaba el perfil. ===== -->
        <Grid x:Name="TabsBar" Grid.Row="0" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="4" ColumnSpacing="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5" Margin="2,0" Padding="4,1" VerticalAlignment="Center">
                <TextBlock Text="LT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
            </Border>
            <Border x:Name="TabPill" Grid.Column="1" CornerRadius="7" Background="{StaticResource Panel3Brush}"
                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" HorizontalAlignment="Left">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="TabPillTransform" />
                </Border.RenderTransform>
            </Border>
            <Button x:Name="TabHome" AutomationProperties.Name="Inicio" Grid.Column="1" Style="{StaticResource FlatButton}" IsTabStop="False" Tag="0" Click="OnTabClick">
                <StackPanel Padding="0,6,0,6" Spacing="2" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource IconText}" FontSize="19" Text="&#xE464;" HorizontalAlignment="Center" />
                    <TextBlock Text="Inicio" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Visibility="Collapsed" />
                </StackPanel>
            </Button>
            <Button x:Name="TabPower" AutomationProperties.Name="Potencia" Grid.Column="2" Style="{StaticResource FlatButton}" IsTabStop="False" Tag="1" Click="OnTabClick">
                <StackPanel Padding="0,6,0,6" Spacing="2" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource IconText}" FontSize="19" Text="&#xE628;" HorizontalAlignment="Center" />
                    <TextBlock Text="Potencia" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Visibility="Collapsed" />
                </StackPanel>
            </Button>
            <Button x:Name="TabDisplay" AutomationProperties.Name="Pantalla" Grid.Column="3" Style="{StaticResource FlatButton}" IsTabStop="False" Tag="2" Click="OnTabClick">
                <StackPanel Padding="0,6,0,6" Spacing="2" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource IconText}" FontSize="19" Text="&#xE32E;" HorizontalAlignment="Center" />
                    <TextBlock Text="Pantalla" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Visibility="Collapsed" />
                </StackPanel>
            </Button>
            <Button x:Name="TabDevice" AutomationProperties.Name="Equipo" Grid.Column="4" Style="{StaticResource FlatButton}" IsTabStop="False" Tag="3" Click="OnTabClick">
                <StackPanel Padding="0,6,0,6" Spacing="2" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource IconText}" FontSize="19" Text="&#xE26E;" HorizontalAlignment="Center" />
                    <TextBlock Text="Equipo" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Visibility="Collapsed" />
                </StackPanel>
            </Button>
            <Button x:Name="TabProfiles" AutomationProperties.Name="Ajustes" Grid.Column="5" Style="{StaticResource FlatButton}" IsTabStop="False" Tag="4" Click="OnTabClick">
                <StackPanel Padding="0,6,0,6" Spacing="2" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource IconText}" FontSize="19" Text="&#xE272;" HorizontalAlignment="Center" />
                    <TextBlock Text="Ajustes" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Visibility="Collapsed" />
                </StackPanel>
            </Button>
            <!-- Punto de «versión nueva» sobre el icono de Ajustes -->
            <Ellipse x:Name="UpdateDot" Grid.Column="5" Width="7" Height="7" Fill="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Top"
                     Margin="20,5,0,0" IsHitTestVisible="False" Visibility="Collapsed" />
            <Border Grid.Column="6" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5" Margin="2,0" Padding="4,1" VerticalAlignment="Center">
                <TextBlock Text="RT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
            </Border>
        </Grid>

        <!-- ===== Paneles (se deslizan al cambiar de pestaña) ===== -->
        <Grid x:Name="PanelHost" Grid.Row="1" SizeChanged="OnPanelHostSizeChanged">

            <!-- INICIO -->
            <ScrollViewer x:Name="HomePanel" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">
                    <!-- Aviso de versión nueva: A lleva a Ajustes › Actualizaciones; X o ✕ lo ocultan para esa versión -->
                    <Grid x:Name="UpdateNotice" Visibility="Collapsed" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="UpdateNoticeButton" Style="{StaticResource FlatButton}" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource AccentBrush}"
                                Padding="10,7" Click="OnUpdateNoticeClick" AutomationProperties.Name="Versión nueva de GoPilot">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource IconText}" FontSize="18" Text="&#xE20C;" Foreground="{StaticResource AccentBrush}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="UpdateNoticeTitle" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="A para ver las novedades · X para ocultar" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button Grid.Column="1" Style="{StaticResource FlatButton}" IsTabStop="False" Width="30" Click="OnUpdateNoticeDismiss"
                                AutomationProperties.Name="Ocultar aviso" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                            <TextBlock Style="{StaticResource IconText}" FontSize="13" Text="&#xE4F6;" />
                        </Button>
                    </Grid>
                    <!-- Brillo y volumen pegados a las baldosas (los Slider ya traen aire propio) -->
                    <Border x:Name="QuickSlidersSection" Style="{StaticResource SectionStyle}" Padding="12,2,12,0" Margin="0,-10,0,-8">
                        <StackPanel>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE472;" />
                                <Slider x:Name="BrightnessSlider" Grid.Column="1" Minimum="0" Maximum="100" StepFrequency="5" SmallChange="10" LargeChange="20"
                                        ValueChanged="OnBrightnessChanged" AutomationProperties.Name="Brillo" />
                                <TextBlock x:Name="BrightnessValue" Grid.Column="2" Style="{StaticResource ValueText}" Text="—" />
                            </Grid>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE44A;" />
                                <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" StepFrequency="5" SmallChange="5" LargeChange="20"
                                        ValueChanged="OnVolumeChanged" AutomationProperties.Name="Volumen" />
                                <TextBlock x:Name="VolumeValue" Grid.Column="2" Style="{StaticResource ValueText}" Text="—" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="EditHomeHint" Visibility="Collapsed" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="2,0"
                               Text="A: marcar una baldosa y después otra para cambiarlas de sitio · mantener A: quitarla · abajo, + para añadir" />
                    <Border Style="{StaticResource SectionStyle}" Padding="12,6,12,12">
                        <Grid x:Name="HomeGrid" ColumnSpacing="6" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="72" />
                                <RowDefinition Height="72" />
                                <RowDefinition Height="72" />
                                <RowDefinition Height="72" />
                                <RowDefinition Height="72" />
                            </Grid.RowDefinitions>
                            <c:Tile x:Name="HomeModeTile" Vertical="True" Glyph="&#xE2DE;" Title="Modo" State="—" Click="OnHomeModeClick" />
                            <c:Tile x:Name="HomeHzTile" Grid.Column="1" Vertical="True" Glyph="&#xE32E;" Title="Refresco" State="—" Click="OnHomeHzClick" />
                            <c:Tile x:Name="HomeBoostTile" Grid.Column="2" Vertical="True" Glyph="&#xE3FE;" Title="CPU Boost" State="—" Click="OnBoostClick" />
                            <c:Tile x:Name="HomeLosslessTile" Grid.Row="1" Vertical="True" Glyph="&#xE0A2;" Title="Lossless" State="—" Available="False" Click="OnLosslessClick" />
                            <c:Tile x:Name="HomeAfmfTile" Grid.Row="1" Grid.Column="1" Vertical="True" Glyph="&#xE792;" Title="AFMF" State="—" Available="False" Tag="afmf" Click="OnAmdClick" />
                            <c:Tile x:Name="HomeRsrTile" Grid.Row="1" Grid.Column="2" Vertical="True" Glyph="&#xE6B6;" Title="RSR" State="—" Available="False" Tag="rsr" Click="OnAmdClick" />
                            <c:Tile x:Name="HomeChillTile" Grid.Row="2" Vertical="True" Glyph="&#xE5AA;" Title="Chill" State="—" Available="False" Tag="chill" Click="OnAmdClick" />
                            <c:Tile x:Name="HomeFanTile" Grid.Row="2" Grid.Column="1" Vertical="True" Glyph="&#xE9F2;" Title="Ventilador" State="—" Click="OnFanClick" />
                            <c:Tile x:Name="HomeOverlayTile" Grid.Row="2" Grid.Column="2" Vertical="True" Glyph="&#xE150;" Title="Overlay" State="—" Click="OnGameOverlayClick" />
                            <c:Tile x:Name="HomeLightsTile" Grid.Row="3" Vertical="True" Glyph="&#xE2DC;" Title="Luces" State="—" Available="False" Click="OnLightsClick" />
                            <c:Tile x:Name="HomeTouchpadTile" Grid.Row="3" Grid.Column="1" Vertical="True" Glyph="&#xE29A;" Title="Touchpad" State="—" Click="OnTouchpadClick" />
                            <c:Tile x:Name="HomeTouchscreenTile" Grid.Row="3" Grid.Column="2" Vertical="True" Glyph="&#xEC90;" Title="Táctil" State="—" Available="False" Click="OnTouchscreenClick" />
                            <c:Tile x:Name="HomeKeyboardTile" Grid.Row="4" Vertical="True" Glyph="&#xE2D8;" Title="Teclado" State="Abrir" Click="OnKeyboardClick" />
                            <c:Tile x:Name="HomeKillTile" Grid.Row="4" Grid.Column="1" Vertical="True" Glyph="&#xE4FA;" Title="Cerrar juego" State="Sin juego" Available="False" Click="OnKillClick" />
                            <c:Tile x:Name="HomeSharpTile" Grid.Row="4" Grid.Column="2" Vertical="True" Glyph="&#xE1EC;" Title="Nitidez" State="—" Available="False" Tag="sharpening" Click="OnAmdClick" />
                        </Grid>
                    </Border>

                    <!-- Editar Inicio: ✕ quita, + añade, A sobre una baldosa y luego sobre otra las intercambia -->
                    <Button x:Name="EditHomeButton" Style="{StaticResource FlatButton}" Background="{StaticResource Panel2Brush}"
                            BorderBrush="{StaticResource LineBrush}" Height="36" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Click="OnEditHomeClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Style="{StaticResource IconText}" FontSize="15" Text="&#xE3B4;" />
                            <TextBlock Text="Editar baldosas" FontSize="12.5" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <StackPanel x:Name="EditHomePanel" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="DISPONIBLES" Style="{StaticResource SectionTitle}" Margin="2,0,0,0" />
                        <Grid x:Name="AvailableGrid" ColumnSpacing="6" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                        <TextBlock x:Name="AvailableEmpty" Text="Todas las baldosas están en Inicio." FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ResetHomeButton" Style="{StaticResource FlatButton}" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource LineBrush}" Height="36"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnResetHomeClick">
                                <TextBlock Text="Restablecer" FontSize="12.5" FontWeight="SemiBold" />
                            </Button>
                            <Button x:Name="DoneHomeButton" Grid.Column="1" Style="{StaticResource ApplyButton}" Click="OnEditHomeDoneClick">
                                <TextBlock Text="Listo" FontSize="13" FontWeight="SemiBold" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- POTENCIA -->
            <ScrollViewer x:Name="PowerPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <Border Style="{StaticResource SectionStyle}">
                        <StackPanel>
                            <TextBlock Text="MODO DE FUNCIONAMIENTO" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                            <Grid ColumnSpacing="5" Height="78">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <c:Tile x:Name="ModeQuiet" Vertical="True" Glyph="&#xE2DA;" Title="10 W" State="" AutomationProperties.Name="Silencio" Tag="quiet" Click="OnModeTileClick" />
                                <c:Tile x:Name="ModeBalanced" Grid.Column="1" Vertical="True" Glyph="&#xE750;" Title="16 W" State="" AutomationProperties.Name="Equilibrado" Tag="balanced" Click="OnModeTileClick" />
                                <c:Tile x:Name="ModePerformance" Grid.Column="2" Vertical="True" Glyph="&#xE2DE;" Title="30 W" State="" AutomationProperties.Name="Rendimiento" Tag="performance" Click="OnModeTileClick" />
                                <c:Tile x:Name="ModeCustom" Grid.Column="3" Vertical="True" Glyph="&#xE434;" Title="—" State="" AutomationProperties.Name="Manual" Tag="custom" Click="OnModeTileClick" />
                                <c:Tile x:Name="ModeAuto" Grid.Column="4" Vertical="True" Glyph="&#xE6B6;" Title="Auto" State="" AutomationProperties.Name="AutoTDP" Tag="auto" Click="OnModeTileClick" />
                            </Grid>

                            <!-- AutoTDP: FPS objetivo y margen de vatios; GoPilot ajusta el límite solo (AutoTdp.cs en el agente) -->
                            <StackPanel x:Name="AutoPanel" Spacing="6" Margin="0,10,0,0" Visibility="Collapsed">
                                <Border Background="{StaticResource Panel2Brush}" CornerRadius="8" Padding="12,10,12,12">
                                    <StackPanel Spacing="8">
                                        <Grid>
                                            <TextBlock Text="FPS objetivo" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                                            <TextBlock x:Name="AutoTargetValue" Text="60" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid x:Name="AutoTargetButtons" ColumnSpacing="5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                        </Grid>
                                        <Grid>
                                            <TextBlock Text="Mínimo" FontSize="12" />
                                            <TextBlock x:Name="AutoMinValue" Style="{StaticResource ValueText}" />
                                        </Grid>
                                        <Slider x:Name="AutoMinSlider" Minimum="5" Maximum="30" StepFrequency="1" ValueChanged="OnAutoRangeChanged" AutomationProperties.Name="Mínimo de AutoTDP" />
                                        <Grid>
                                            <TextBlock Text="Máximo" FontSize="12" />
                                            <TextBlock x:Name="AutoMaxValue" Style="{StaticResource ValueText}" />
                                        </Grid>
                                        <Slider x:Name="AutoMaxSlider" Minimum="5" Maximum="30" StepFrequency="1" ValueChanged="OnAutoRangeChanged" AutomationProperties.Name="Máximo de AutoTDP" />
                                        <Border Background="{StaticResource Panel3Brush}" CornerRadius="6" Padding="9,7">
                                            <TextBlock x:Name="AutoLiveText" FontSize="11.5" TextWrapping="Wrap" />
                                        </Border>
                                        <c:Tile Row="switch" x:Name="AutoChillTile" Glyph="&#xE5AA;" Title="Limitar FPS con Radeon Chill" State="—" Click="OnAutoChillClick" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <!-- Manual, como la Steam Deck: un límite de potencia (SPL); ráfagas (sPPT) y picos (fPPT) se calculan
                                 solos por encima. Se aplica al soltar el deslizador (sin botón «Aplicar»). Avanzado: tocarlos a mano. -->
                            <StackPanel x:Name="TdpPanel" Spacing="6" Margin="0,10,0,0" Visibility="Collapsed">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform x:Name="TdpPanelTransform" />
                                </StackPanel.RenderTransform>
                                <Border Background="{StaticResource Panel2Brush}" CornerRadius="8" Padding="12,10,12,12">
                                    <StackPanel Spacing="4">
                                        <Grid>
                                            <TextBlock Text="Límite de potencia" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                                <Run x:Name="SplValue" Text="—" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" /><Run Text=" W" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                            </TextBlock>
                                        </Grid>
                                        <Slider x:Name="SplSlider" Minimum="5" Maximum="30" StepFrequency="1" ValueChanged="OnTdpSliderChanged" AutomationProperties.Name="Límite de potencia" />
                                        <Grid Margin="0,-6,0,0">
                                            <TextBlock x:Name="SplMinText" Text="5 W" FontSize="10.5" Foreground="{StaticResource MutedBrush}" />
                                            <TextBlock x:Name="SplMaxText" Text="30 W" FontSize="10.5" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Border Background="{StaticResource Panel3Brush}" CornerRadius="6" Padding="9,7" Margin="0,4,0,0">
                                            <TextBlock x:Name="TdpAutoText" FontSize="11.5" TextWrapping="Wrap" />
                                        </Border>
                                        <TextBlock x:Name="TdpNowText" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                                <!-- Tarjeta: la fila «Avanzado» y sus deslizadores comparten fondo -->
                                <Border Background="{StaticResource Panel2Brush}" CornerRadius="8">
                                    <StackPanel>
                                        <c:Tile Row="sub" x:Name="TdpAdvancedTile" Glyph="&#xE434;" Title="Avanzado" State="sPPT y fPPT" Click="OnTdpAdvancedClick" />
                                        <StackPanel x:Name="TdpAdvancedBody" Spacing="4" Margin="12,4,12,12" Visibility="Collapsed">
                                            <c:Tile Row="switch" x:Name="TdpAutoTile" Glyph="&#xE2DE;" Title="Ráfagas y picos automáticos" State="—" Click="OnTdpAutoClick" />
                                            <Grid Margin="0,6,0,0">
                                                <TextBlock FontSize="12.5"><Run Text="sPPT" /><Run Text="  ráfagas · hasta 1 min" FontSize="11" Foreground="{StaticResource MutedBrush}" /></TextBlock>
                                                <TextBlock x:Name="SpptValue" Style="{StaticResource ValueText}" />
                                            </Grid>
                                            <Slider x:Name="SpptSlider" Minimum="5" Maximum="32" StepFrequency="1" ValueChanged="OnTdpSliderChanged" AutomationProperties.Name="sPPT" />
                                            <Grid>
                                                <TextBlock FontSize="12.5"><Run Text="fPPT" /><Run Text="  picos · fracciones de segundo" FontSize="11" Foreground="{StaticResource MutedBrush}" /></TextBlock>
                                                <TextBlock x:Name="FpptValue" Style="{StaticResource ValueText}" />
                                            </Grid>
                                            <Slider x:Name="FpptSlider" Minimum="5" Maximum="41" StepFrequency="1" ValueChanged="OnTdpSliderChanged" AutomationProperties.Name="fPPT" />
                                            <TextBlock x:Name="TdpNote" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}" Visibility="Collapsed" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="PROCESADOR" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Z1 Extreme · 8 núcleos" Style="{StaticResource SectionHint}" />
                            </Grid>
                            <c:Tile Row="switch" x:Name="PowerBoostTile" Glyph="&#xE3FE;" Title="CPU Boost" State="—" Click="OnBoostClick" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="VENTILADOR" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="FanHintText" Text="Curva automática" Style="{StaticResource SectionHint}" />
                            </Grid>
                            <StackPanel Spacing="3">
                                <c:Tile Row="switch" x:Name="PowerFanTile" Glyph="&#xE9F2;" Title="Ventilador al máximo" State="—" Click="OnFanClick" />
                                <!-- Tarjeta: la fila y sus ajustes comparten fondo (se ve que van juntos) -->
                                <Border Background="{StaticResource Panel2Brush}" CornerRadius="8">
                                    <StackPanel>
                                        <c:Tile Row="sub" x:Name="FanCurveTile" Glyph="&#xE156;" Title="Curva del ventilador" State="—" Available="False" Click="OnFanCurveClick" />
                                        <!-- Curva: velocidad a 10…100 °C; solo actúa en modo Manual -->
                                        <StackPanel x:Name="FanCurvePanel" Spacing="4" Margin="12,4,12,12" Visibility="Collapsed">
                                            <c:Selector x:Name="FanPresetSelector" Label="Curva" SelectionChanged="OnFanPresetSelected" />
                                            <TextBlock x:Name="FanCurveNote" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,4" />
                                            <StackPanel x:Name="FanCurveSliders" Spacing="0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- PANTALLA -->
            <ScrollViewer x:Name="DisplayPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <Border Style="{StaticResource SectionStyle}">
                        <StackPanel>
                            <TextBlock Text="PANTALLA" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                            <StackPanel Spacing="8">
                                <c:Selector x:Name="ResolutionSelector" Label="Resolución" SelectionChanged="OnResolutionSelected" />
                                <c:Selector x:Name="RefreshSelector" Label="Refresco" SelectionChanged="OnRefreshSelected" />
                            </StackPanel>
                        </StackPanel>
                    </Border>



                    <Border Style="{StaticResource SectionStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="AMD RADEON" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="vía ADLX" Style="{StaticResource SectionHint}" />
                            </Grid>
                            <StackPanel Spacing="3">
                                <c:Tile Row="switch" x:Name="AmdAfmfTile" Glyph="&#xE792;" Title="AFMF" State="—" Available="False" Tag="afmf" Click="OnAmdClick" />
                                <c:Tile Row="switch" x:Name="AmdRsrTile" Glyph="&#xE6B6;" Title="RSR" State="—" Available="False" Tag="rsr" Click="OnAmdClick" />
                                <!-- Tarjeta: la fila y sus ajustes comparten fondo (se ve que van juntos) -->
                                <Border Background="{StaticResource Panel2Brush}" CornerRadius="8">
                                    <StackPanel>
                                        <c:Tile Row="switch" x:Name="AmdChillTile" Glyph="&#xE5AA;" Title="Chill" State="—" Available="False" Tag="chill" Click="OnAmdClick" />
                                        <!-- Radeon Chill: FPS mínimos (en reposo) y máximos (en acción); visible con Chill activado -->
                                        <StackPanel x:Name="ChillPanel" Spacing="2" Margin="12,4,12,12" Visibility="Collapsed">
                                            <Grid>

<Page
    x:Class="GoSPanel.Widget.MainWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:GoSPanel.Widget.Controls"
    Background="Transparent"
    XYFocusKeyboardNavigation="Enabled">

    <!-- Fondo transparente: se ve el de Game Bar. El contenido se amplía con una escala fija (ver OnScaleHostSizeChanged).
         Diseño de una sola página (design/perfil-modo-baldosas.html): información del sistema arriba, filtros (LT / RT),
         baldosas en dos columnas que se amplían con sus opciones y, abajo, qué hace cada botón del mando. -->
    <Grid x:Name="ScaleHost" Background="{StaticResource PageBrush}" SizeChanged="OnScaleHostSizeChanged">
    <Grid x:Name="LayoutRoot" Padding="10,6,10,0" RowSpacing="8" HorizontalAlignment="Left" VerticalAlignment="Top">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Información del sistema: batería (o carga), FPS, W, temperatura y ventilador en una tarjeta ===== -->
        <Grid x:Name="StatusCard" Background="{StaticResource Panel2Brush}" CornerRadius="12" Padding="4,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.75*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Padding="8,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock x:Name="BatteryIcon" Style="{StaticResource IconText}" FontSize="17" Text="&#xE0C2;" Foreground="{StaticResource IconBrush}" />
                    <TextBlock x:Name="BatteryValue" Text="—" FontSize="17" FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock x:Name="BatterySub" Text="batería" FontSize="10" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Border Grid.Column="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="FpsValue" Text="—" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource OkBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="FPS" FontSize="10" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="PowerValue" Text="—" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="W" FontSize="10" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="TempValue" Text="—" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="APU" FontSize="10" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="FanValue" Text="—" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="RPM" FontSize="10" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="1">
            <!-- ===== Brillo y volumen (solo en «Todo»; maqueta design/brillo-volumen.html, opción 1): con el foco encima,
                 ← → los cambian al momento. A: brillo automático / silenciar. Se pliegan con animación en los demás filtros. ===== -->
            <Grid x:Name="QuickBars" SizeChanged="OnQuickBarsSizeChanged">
                <StackPanel Spacing="6" Padding="0,0,0,8" VerticalAlignment="Top">
                    <c:LevelBar x:Name="BrightnessBar" Glyph="&#xE472;" Label="Brillo" ValueChanged="OnBrightnessBarChanged" Click="OnBrightnessBarClick" />
                    <c:LevelBar x:Name="VolumeBar" Glyph="&#xE44A;" Label="Volumen" StepSize="5" ValueChanged="OnVolumeBarChanged" Click="OnVolumeBarClick" />
                </StackPanel>
            </Grid>
            <!-- ===== Filtros (LT / RT; LB / RB son de Game Bar). No reciben el foco: se cambian con los gatillos o tocando. ===== -->
            <ScrollViewer x:Name="FiltersScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" IsTabStop="False">
                <StackPanel x:Name="FiltersBar" Orientation="Horizontal" Spacing="5" />
            </ScrollViewer>
        </StackPanel>

        <!-- ===== Baldosas ===== -->
        <ScrollViewer x:Name="ContentScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" IsTabStop="False">
            <StackPanel Spacing="8" Padding="0,0,0,10">
                <Grid x:Name="UpdateNotice" Visibility="Collapsed" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="UpdateNoticeButton" Style="{StaticResource FlatButton}" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource AccentBrush}"
                            Padding="10,7" Click="OnUpdateNoticeClick" AutomationProperties.Name="Versión nueva de GoPilot">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource IconText}" FontSize="18" Text="&#xE20C;" Foreground="{StaticResource AccentBrush}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="UpdateNoticeTitle" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="A para ver las novedades · X para ocultar" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource FlatButton}" IsTabStop="False" Width="30" Click="OnUpdateNoticeDismiss"
                            AutomationProperties.Name="Ocultar aviso" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                        <TextBlock Style="{StaticResource IconText}" FontSize="13" Text="&#xE4F6;" />
                    </Button>
                </Grid>
                <c:TileGrid x:Name="CardsGrid">

                    <!-- ===== Siempre arriba ===== -->
                    <c:Card x:Name="ProfileCard" Key="True" Pinned="True" Click="OnProfileCardClick" Glyph="&#xE26E;" Title="Perfil" Value="Global" State="Perfil Global">
                        <StackPanel Spacing="6" Margin="0,4,0,0">
                            <c:Tile Row="switch" x:Name="AutoProfilesTile" Glyph="&#xE036;" Title="Aplicar perfiles automáticamente" State="—" Click="OnAutoProfilesClick" />
                            <c:Tile Row="switch" x:Name="AutoSaveTile" Glyph="&#xE248;" Title="Guardar cambios automáticamente" State="—" Click="OnAutoSaveClick" />
                            <Button x:Name="SaveProfileButton" Style="{StaticResource FlatButton}" Background="{StaticResource Panel3Brush}" Visibility="Collapsed"
                                    Height="34" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnSaveProfileClick">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock x:Name="SaveProfileIcon" Style="{StaticResource IconText}" FontSize="15" Text="&#xE248;" />
                                    <TextBlock Text="Guardar en el perfil activo" FontSize="12.5" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Grid Margin="2,4,2,0">
                                <TextBlock Text="PERFILES" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="ProfileCountText" Style="{StaticResource SectionHint}" />
                            </Grid>
                            <StackPanel x:Name="ProfilesList" Spacing="4" />
                            <TextBlock x:Name="ProfilesEmptyText" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                       Text="Abre un juego: GoPilot le crea un perfil con los ajustes de ese momento y lo vuelve a aplicar cada vez que lo abras." />
                        </StackPanel>
                    </c:Card>

                    <c:Card x:Name="ModeCard" Key="True" Pinned="True" Quick="cycle" Glyph="&#xE750;" Title="Modo" Value="—" State="" Click="OnModeCardClick">
                        <StackPanel Spacing="8" Margin="0,4,0,0">
                            <Grid ColumnSpacing="5" RowSpacing="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="64" />
                                    <RowDefinition Height="64" />
                                </Grid.RowDefinitions>
                                <c:Tile x:Name="ModeQuiet" Grid.ColumnSpan="2" Vertical="True" Glyph="&#xE2DA;" Title="Silencio" State="10 W" Tag="quiet" Click="OnModeTileClick" />
                                <c:Tile x:Name="ModeBalanced" Grid.Column="2" Grid.ColumnSpan="2" Vertical="True" Glyph="&#xE750;" Title="Equilibrado" State="16 W" Tag="balanced" Click="OnModeTileClick" />
                                <c:Tile x:Name="ModePerformance" Grid.Column="4" Grid.ColumnSpan="2" Vertical="True" Glyph="&#xE2DE;" Title="Rendimiento" State="30 W" Tag="performance" Click="OnModeTileClick" />
                                <c:Tile x:Name="ModeCustom" Grid.Row="1" Grid.ColumnSpan="3" Vertical="True" Glyph="&#xE434;" Title="Manual" State="—" Tag="custom" Click="OnModeTileClick" />
                                <c:Tile x:Name="ModeAuto" Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="3" Vertical="True" Glyph="&#xE6B6;" Title="Auto" State="FPS" Tag="auto" Click="OnModeTileClick" />
                            </Grid>
                            <StackPanel x:Name="AutoPanel" Spacing="6" Visibility="Collapsed">
                                <Border Background="{StaticResource Panel2Brush}" CornerRadius="8" Padding="12,10,12,12">
                                    <StackPanel Spacing="8">
                                        <Grid>
                                            <TextBlock VerticalAlignment="Bottom" Margin="0,0,0,3"><Run Text="FPS objetivo" FontSize="13" FontWeight="SemiBold" /><Run Text="  reales (AFMF los duplica)" FontSize="11" Foreground="{StaticResource MutedBrush}" /></TextBlock>
                                            <TextBlock x:Name="AutoTargetValue" Text="60" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid x:Name="AutoTargetButtons" ColumnSpacing="5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                        </Grid>
                                        <Grid>
                                            <TextBlock Text="Mínimo" FontSize="12" />
                                            <TextBlock x:Name="AutoMinValue" Style="{StaticResource ValueText}" />
                                        </Grid>
                                        <Slider x:Name="AutoMinSlider" Minimum="5" Maximum="30" StepFrequency="1" ValueChanged="OnAutoRangeChanged" AutomationProperties.Name="Mínimo de AutoTDP" />
                                        <Grid>
                                            <TextBlock Text="Máximo" FontSize="12" />
                                            <TextBlock x:Name="AutoMaxValue" Style="{StaticResource ValueText}" />
                                        </Grid>
                                        <Slider x:Name="AutoMaxSlider" Minimum="5" Maximum="30" StepFrequency="1" ValueChanged="OnAutoRangeChanged" AutomationProperties.Name="Máximo de AutoTDP" />
                                        <Border Background="{StaticResource Panel3Brush}" CornerRadius="6" Padding="9,7">
                                            <TextBlock x:Name="AutoLiveText" FontSize="11.5" TextWrapping="Wrap" />
                                        </Border>
                                        <c:Tile Row="switch" x:Name="AutoChillTile" Glyph="&#xE5AA;" Title="Limitar FPS con Radeon Chill" State="—" Click="OnAutoChillClick" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel x:Name="TdpPanel" Spacing="6" Visibility="Collapsed">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform x:Name="TdpPanelTransform" />
                                </StackPanel.RenderTransform>
                                <Border Background="{StaticResource Panel2Brush}" CornerRadius="8" Padding="12,10,12,12">
                                    <StackPanel Spacing="4">
                                        <Grid>
                                            <TextBlock Text="Límite de potencia" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                                <Run x:Name="SplValue" Text="—" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" /><Run Text=" W" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                            </TextBlock>
                                        </Grid>
                                        <Slider x:Name="SplSlider" Minimum="5" Maximum="30" StepFrequency="1" ValueChanged="OnTdpSliderChanged" AutomationProperties.Name="Límite de potencia" />
                                        <Grid Margin="0,-6,0,0">
                                            <TextBlock x:Name="SplMinText" Text="5 W" FontSize="10.5" Foreground="{StaticResource MutedBrush}" />
                                            <TextBlock x:Name="SplMaxText" Text="30 W" FontSize="10.5" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Border Background="{StaticResource Panel3Brush}" CornerRadius="6" Padding="9,7" Margin="0,4,0,0">
                                            <TextBlock x:Name="TdpAutoText" FontSize="11.5" TextWrapping="Wrap" />
                                        </Border>
                                        <TextBlock x:Name="TdpNowText" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                                <!-- Tarjeta: la fila «Avanzado» y sus deslizadores comparten fondo -->
                                <Border Background="{StaticResource Panel2Brush}" CornerRadius="8">
                                    <StackPanel>
                                        <c:Tile Row="sub" x:Name="TdpAdvancedTile" Glyph="&#xE434;" Title="Avanzado" State="sPPT y fPPT" Click="OnTdpAdvancedClick" />
                                        <StackPanel x:Name="TdpAdvancedBody" Spacing="4" Margin="12,4,12,12" Visibility="Collapsed">
                                            <c:Tile Row="switch" x:Name="TdpAutoTile" Glyph="&#xE2DE;" Title="Ráfagas y picos automáticos" State="—" Click="OnTdpAutoClick" />
                                            <Grid Margin="0,6,0,0">
                                                <TextBlock FontSize="12.5"><Run Text="sPPT" /><Run Text="  ráfagas · hasta 1 min" FontSize="11" Foreground="{StaticResource MutedBrush}" /></TextBlock>
                                                <TextBlock x:Name="SpptValue" Style="{StaticResource ValueText}" />
                                            </Grid>
                                            <Slider x:Name="SpptSlider" Minimum="5" Maximum="32" StepFrequency="1" ValueChanged="OnTdpSliderChanged" AutomationProperties.Name="sPPT" />
                                            <Grid>
                                                <TextBlock FontSize="12.5"><Run Text="fPPT" /><Run Text="  picos · fracciones de segundo" FontSize="11" Foreground="{StaticResource MutedBrush}" /></TextBlock>
                                                <TextBlock x:Name="FpptValue" Style="{StaticResource ValueText}" />
                                            </Grid>
                                            <Slider x:Name="FpptSlider" Minimum="5" Maximum="41" StepFrequency="1" ValueChanged="OnTdpSliderChanged" AutomationProperties.Name="fPPT" />
                                            <TextBlock x:Name="TdpNote" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}" Visibility="Collapsed" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </c:Card>

                    <!-- ===== Más usadas (salen en «Todo» por defecto) ===== -->
                    <c:Card x:Name="AfmfCard" Filter="AMD" Quick="toggle" Glyph="&#xE792;" Title="AFMF" State="—" Available="False" Tag="afmf" Click="OnAmdClick" />
                    <c:Card x:Name="VrrCard" Filter="Pantalla AMD" Quick="toggle" Glyph="&#xE094;" Title="VRR" State="—" Available="False" Tag="freesync" Click="OnAmdClick" />
                    <c:Card x:Name="BoostCard" Filter="Rendimiento" Quick="toggle" Glyph="&#xE3FE;" Title="CPU Boost" State="—" Click="OnBoostClick" />

                    <c:Card x:Name="LightsCard" Filter="Mando" Quick="cycle" Glyph="&#xE2DC;" Title="Luces" Value="—" State="—" Available="False" Click="OnLightsCardClick">
                        <StackPanel x:Name="LightsPanel" Spacing="10" Margin="0,4,0,0">
                            <TextBlock x:Name="LightsOffText" FontSize="12.5" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                       Text="Las luces están apagadas: pulsa A en la baldosa para encenderlas." />
                            <StackPanel x:Name="LightsSettings" Spacing="8">
                            <StackPanel x:Name="LightBrightnessRow" Spacing="2">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Style="{StaticResource IconText}" FontSize="14" Text="&#xE474;" />
                                        <TextBlock Text="Brillo" FontSize="11.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="LightBrightnessValue" Style="{StaticResource ValueText}" FontSize="12" />
                                </Grid>
                                <Slider x:Name="LightBrightnessSlider" Minimum="10" Maximum="100" StepFrequency="10" SmallChange="10"
                                        ValueChanged="OnLightSliderChanged" AutomationProperties.Name="Brillo de las luces" />
                            </StackPanel>
                            <!-- Reactivo: brillo en reposo y en los golpes del sonido -->
                            <StackPanel x:Name="ReactiveRows" Spacing="8" Visibility="Collapsed">
                                <StackPanel Spacing="2">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Style="{StaticResource IconText}" FontSize="14" Text="&#xE474;" />
                                            <TextBlock Text="Reposo" FontSize="11.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock x:Name="ReactiveLowValue" Style="{StaticResource ValueText}" FontSize="12" />
                                    </Grid>
                                    <Slider x:Name="ReactiveLowSlider" Minimum="0" Maximum="60" StepFrequency="5" SmallChange="5"
                                            ValueChanged="OnLightSliderChanged" AutomationProperties.Name="Brillo en reposo" />
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Style="{StaticResource IconText}" FontSize="14" Text="&#xE2DE;" />
                                            <TextBlock Text="Pico con el sonido" FontSize="11.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock x:Name="ReactiveHighValue" Style="{StaticResource ValueText}" FontSize="12" />
                                    </Grid>
                                    <Slider x:Name="ReactiveHighSlider" Minimum="30" Maximum="100" StepFrequency="5" SmallChange="5"
                                            ValueChanged="OnLightSliderChanged" AutomationProperties.Name="Brillo en los golpes" />
                                </StackPanel>
                            </StackPanel>
                            <!-- Una sola columna: efecto, velocidad y colores (todos en una fila) -->
                            <c:Selector x:Name="EffectSelector" Label="Efecto" SelectionChanged="OnEffectSelected" />
                            <StackPanel x:Name="LightSpeedRow" Spacing="2">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Style="{StaticResource IconText}" FontSize="14" Text="&#xE492;" />
                                        <TextBlock Text="Velocidad" FontSize="11.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="LightSpeedValue" Style="{StaticResource ValueText}" FontSize="12" />
                                </Grid>
                                <Slider x:Name="LightSpeedSlider" Minimum="0" Maximum="100" StepFrequency="10" SmallChange="10"
                                        ValueChanged="OnLightSliderChanged" AutomationProperties.Name="Velocidad del efecto" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Color" FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
                                <VariableSizedWrapGrid x:Name="ColorSwatches" Orientation="Horizontal" MaximumRowsOrColumns="10"
                                                       ItemWidth="30" ItemHeight="30" HorizontalAlignment="Center" />
                            </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </c:Card>

                    <c:Card x:Name="RefreshCard" Filter="Pantalla" Quick="cycle" Glyph="&#xE32E;" Title="Refresco" Value="—" State="Frecuencia" Click="OnHomeHzClick">
                        <c:Selector x:Name="RefreshSelector" Label="Refresco" SelectionChanged="OnRefreshSelected" />
                    </c:Card>

                    <c:Card x:Name="FanCard" Filter="Rendimiento" Quick="toggle" Glyph="&#xE9F2;" Title="Ventilador" Value="Auto" State="—" Click="OnFanClick">
                        <Border Background="{StaticResource Panel2Brush}" CornerRadius="8">
                            <StackPanel>
                                <c:Tile Row="sub" x:Name="FanCurveTile" Glyph="&#xE156;" Title="Curva del ventilador" State="—" Available="False" Click="OnFanCurveClick" />
                                <!-- Curva: velocidad a 10…100 °C; solo actúa en modo Manual -->
                                <StackPanel x:Name="FanCurvePanel" Spacing="4" Margin="12,4,12,12" Visibility="Collapsed">
                                    <c:Selector x:Name="FanPresetSelector" Label="Curva" SelectionChanged="OnFanPresetSelected" />
                                    <TextBlock x:Name="FanCurveNote" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,4" />
                                    <StackPanel x:Name="FanCurveSliders" Spacing="0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </c:Card>

                    <!-- ===== Rendimiento ===== -->
                    <c:Card x:Name="ChargeCard" Filter="Rendimiento" Quick="toggle" Glyph="&#xE0BA;" Title="Carga al 80 %" State="—" Click="OnChargeClick">
                        <TextBlock x:Name="BatteryHealthText" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Cargar solo hasta el 80 % alarga la vida de la batería si la consola pasa mucho tiempo enchufada." />
                    </c:Card>

                    <!-- ===== Pantalla ===== -->
                    <c:Card x:Name="ResolutionCard" Filter="Pantalla" Glyph="&#xE0A2;" Title="Resolución" Value="—" State="Pantalla">
                        <c:Selector x:Name="ResolutionSelector" Label="Resolución" SelectionChanged="OnResolutionSelected" />
                    </c:Card>
                    <c:Card x:Name="VariBrightCard" Filter="Pantalla AMD" Quick="toggle" Glyph="&#xE5B6;" Title="Vari-Bright" State="—" Available="False" Tag="varibright" Click="OnAmdClick" />
                    <c:Card x:Name="LosslessCard" Filter="Pantalla" Quick="toggle" Glyph="&#xE0A6;" Title="Lossless" State="—" Available="False" Click="OnLosslessClick" />
                    <c:Card x:Name="OverlayCard" Filter="Pantalla" Quick="toggle" Glyph="&#xE154;" Title="Overlay" Value="—" State="FPS en el juego" Click="OnGameOverlayClick">
                        <StackPanel Spacing="8" Margin="0,4,0,0">
                            <c:Tile Row="value" x:Name="GameOverlayTile" Glyph="&#xE58C;" Title="Overlay en juegos" State="—" Click="OnOverlayCycleClick" />
                            <StackPanel Spacing="8" x:Name="OverlaySettings" Visibility="Collapsed">
                                <c:Selector x:Name="OverlayContentSelector" Label="Overlay · mostrar" SelectionChanged="OnOverlayContentSelected" />
                                <c:Selector x:Name="OverlayPositionSelector" Label="Overlay · posición" SelectionChanged="OnOverlayPositionSelected" />
                            </StackPanel>
                        </StackPanel>
                    </c:Card>

                    <!-- ===== AMD ===== -->
                    <c:Card x:Name="RsrCard" Filter="AMD" Quick="toggle" Glyph="&#xE6B6;" Title="RSR" State="—" Available="False" Tag="rsr" Click="OnAmdClick" />
                    <c:Card x:Name="ChillCard" Filter="AMD" Quick="toggle" Glyph="&#xE5AA;" Title="Chill" Value="—" State="Límite de FPS" Available="False" Tag="chill" Click="OnAmdClick">
                        <StackPanel Margin="0,4,0,0">
                            <TextBlock x:Name="ChillOffText" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                       Text="Chill está apagado: enciéndelo con A para elegir los FPS mínimos y máximos." />
                            <StackPanel x:Name="ChillPanel" Spacing="2" Visibility="Collapsed">
                                <Grid>
                                    <TextBlock Text="Chill · FPS mínimos" FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock x:Name="ChillMinValue" Style="{StaticResource ValueText}" FontSize="12" />
                                </Grid>
                                <Slider x:Name="ChillMinSlider" StepFrequency="5" SmallChange="5" ValueChanged="OnChillSliderChanged" AutomationProperties.Name="FPS mínimos de Chill" />
                                <Grid>
                                    <TextBlock Text="Chill · FPS máximos" FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock x:Name="ChillMaxValue" Style="{StaticResource ValueText}" FontSize="12" />
                                </Grid>
                                <Slider x:Name="ChillMaxSlider" StepFrequency="5" SmallChange="5" ValueChanged="OnChillSliderChanged" AutomationProperties.Name="FPS máximos de Chill" />
                            </StackPanel>
                        </StackPanel>
                    </c:Card>
                    <c:Card x:Name="SharpCard" Filter="AMD" Quick="toggle" Glyph="&#xE1EC;" Title="Nitidez" State="—" Available="False" Tag="sharpening" Click="OnAmdClick" />
                    <c:Card x:Name="AntiLagCard" Filter="AMD" Quick="toggle" Glyph="&#xE492;" Title="Anti-Lag" State="—" Available="False" Tag="antilag" Click="OnAmdClick" />

                    <!-- ===== Mando ===== -->

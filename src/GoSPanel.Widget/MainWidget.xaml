                                            <Button x:Name="UpdateLaterButton" Grid.Column="1" Style="{StaticResource FlatButton}" Background="{StaticResource Panel3Brush}" Height="34"
                                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnUpdateLaterClick">
                                                <TextBlock Text="Más tarde" FontSize="13" FontWeight="SemiBold" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <c:Tile Row="switch" x:Name="AutoUpdateTile" Glyph="&#xE094;" Title="Buscar automáticamente" State="—" Click="OnAutoUpdateClick" />
                            <c:Tile Row="value" x:Name="UninstallTile" Glyph="&#xE4A6;" Title="Desinstalar GoPilot" State="" Click="OnUninstallClick" />
                            <c:Tile Row="switch" x:Name="LegionSpaceTile" Glyph="&#xE6A2;" Title="Legion Space" State="—" Available="False" Click="OnLegionSpaceClick" />
                            <c:Tile Row="switch" x:Name="ResumeTile" Glyph="&#xE036;" Title="Reaplicar ajustes tras suspender" State="—" Click="OnResumeClick" />
                            <TextBlock x:Name="AboutText" FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="11.5" IsTextSelectionEnabled="True"
                                       Foreground="{StaticResource MutedBrush}" MaxLines="12" />
                        </StackPanel>
                    </c:Card>

                    <!-- Editar qué sale en «Todo» (solo en ese filtro); en edición, «Listo» -->
                    <Button x:Name="EditTodoButton" Style="{StaticResource FlatButton}" Background="{StaticResource Panel2Brush}" Height="36"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnEditTodoClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Name="EditTodoIcon" Style="{StaticResource IconText}" FontSize="15" Text="&#xE3B4;" />
                            <TextBlock x:Name="EditTodoText" Text="Elegir las baldosas de Todo" FontSize="12.5" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </c:TileGrid>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Qué hace cada botón en la baldosa elegida (como la app de Xbox) ===== -->
        <Grid x:Name="HintBar" Grid.Row="3" Background="{StaticResource DockBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
              Margin="-10,0,-10,0" Padding="12,0" Height="30">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <StackPanel x:Name="HintA" Orientation="Horizontal" Spacing="5">
                    <Border Width="16" Height="16" CornerRadius="8" Background="#FF3DDC84"><TextBlock Text="A" FontSize="9.5" FontWeight="Bold" Foreground="#FF101010" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <TextBlock x:Name="HintAText" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel x:Name="HintY" Orientation="Horizontal" Spacing="5">
                    <Border Width="16" Height="16" CornerRadius="8" Background="#FFF5C542"><TextBlock Text="Y" FontSize="9.5" FontWeight="Bold" Foreground="#FF101010" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <TextBlock Text="Opciones" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel x:Name="HintPad" Orientation="Horizontal" Spacing="5">
                    <Border Height="16" CornerRadius="4" Padding="3,0" Background="#FFC9CAD0"><TextBlock Text="← →" FontSize="9.5" FontWeight="Bold" Foreground="#FF101010" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <TextBlock Text="Ajustar" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel x:Name="HintB" Orientation="Horizontal" Spacing="5">
                    <Border Width="16" Height="16" CornerRadius="8" Background="#FFFF5B5B"><TextBlock Text="B" FontSize="9.5" FontWeight="Bold" Foreground="#FF101010" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <TextBlock Text="Cerrar" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="ConnectionText" Text="" FontSize="11" Foreground="{StaticResource WarnBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

    </Grid>
    </Grid>
</Page>

<Page
    x:Class="GoSPanel.Widget.MainWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:GoSPanel.Widget.Controls"
    Background="Transparent"
    XYFocusKeyboardNavigation="Enabled">

    <!-- Diseño del menú de Legion L (maqueta design/widget-gamebar-completo.html): fondo negro, pestañas de iconos
         (la elegida con nombre y contorno blanco), filas en tarjetas y foco blanco.
         Pestañas: Inicio · Rendimiento · Pantalla · Mando · Sistema (los nombres internos de los paneles no cambian:
         HomePanel, PowerPanel, DisplayPanel, DevicePanel, ProfilesPanel).
         Lo que se abre aparte (Avanzado de potencia, sticks, gatillos, giroscopio, luces) va a una subpágina (SubPanel):
         A entra, B vuelve. El contenido se amplía con una escala fija (ver OnScaleHostSizeChanged). -->
    <Grid x:Name="ScaleHost" Background="{StaticResource PageBrush}" SizeChanged="OnScaleHostSizeChanged">
    <Grid x:Name="LayoutRoot" Padding="14,10,14,10" RowSpacing="6" HorizontalAlignment="Left" VerticalAlignment="Top">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Pestañas (LT / RT; Game Bar se reserva LB / RB para cambiar de widget). Solo iconos; la elegida
             lleva además su nombre y un contorno blanco (TabPill), que se desliza de una a otra. ===== -->
        <Grid x:Name="TabsBar" Grid.Row="0" ColumnSpacing="2" Padding="0,2,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Pestañas centradas entre LT y RT (columnas * a los lados) -->
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5" Margin="0,0,4,0" Padding="5,1" VerticalAlignment="Center">
                <TextBlock Text="LT" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
            </Border>
            <Border x:Name="TabPill" Grid.Column="2" Grid.ColumnSpan="5" CornerRadius="18" Background="#1FFFFFFF"
                    BorderBrush="White" BorderThickness="1.5" HorizontalAlignment="Left" IsHitTestVisible="False">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="TabPillTransform" />
                </Border.RenderTransform>
            </Border>
            <Button x:Name="TabHome" AutomationProperties.Name="Inicio" Grid.Column="2" Style="{StaticResource FlatButton}" IsTabStop="False" Tag="0" Click="OnTabClick">
                <StackPanel Orientation="Horizontal" Padding="12,0,12,0" Height="36" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource IconText}" FontSize="18" Text="&#xE2C2;" />
                    <TextBlock Text="Inicio" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="7,0,0,0" />
                </StackPanel>
            </Button>
            <Button x:Name="TabPower" AutomationProperties.Name="Rendimiento" Grid.Column="3" Style="{StaticResource FlatButton}" IsTabStop="False" Tag="1" Click="OnTabClick">
                <StackPanel Orientation="Horizontal" Padding="12,0,12,0" Height="36" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource IconText}" FontSize="18" Text="&#xE2DE;" />
                    <TextBlock Text="Rendimiento" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="7,0,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Button>
            <Button x:Name="TabDisplay" AutomationProperties.Name="Pantalla" Grid.Column="4" Style="{StaticResource FlatButton}" IsTabStop="False" Tag="2" Click="OnTabClick">
                <StackPanel Orientation="Horizontal" Padding="12,0,12,0" Height="36" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource IconText}" FontSize="18" Text="&#xE32E;" />
                    <TextBlock Text="Pantalla" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="7,0,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Button>
            <Button x:Name="TabDevice" AutomationProperties.Name="Mando" Grid.Column="5" Style="{StaticResource FlatButton}" IsTabStop="False" Tag="3" Click="OnTabClick">
                <StackPanel Orientation="Horizontal" Padding="12,0,12,0" Height="36" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource IconText}" FontSize="18" Text="&#xE26E;" />
                    <TextBlock Text="Mando" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="7,0,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Button>
            <Button x:Name="TabProfiles" AutomationProperties.Name="Sistema" Grid.Column="6" Style="{StaticResource FlatButton}" IsTabStop="False" Tag="4" Click="OnTabClick">
                <StackPanel Orientation="Horizontal" Padding="12,0,12,0" Height="36" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource IconText}" FontSize="18" Text="&#xE272;" />
                    <TextBlock Text="Sistema" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="7,0,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Button>
            <!-- Punto de «versión nueva» sobre el icono de Sistema -->
            <Ellipse x:Name="UpdateDot" Grid.Column="6" Width="7" Height="7" Fill="{StaticResource WarnBrush}" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,5,7,0" IsHitTestVisible="False" Visibility="Collapsed" />
            <Border Grid.Column="8" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5" Padding="5,1" VerticalAlignment="Center">
                <TextBlock Text="RT" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
            </Border>
        </Grid>

        <!-- ===== Paneles (se deslizan al cambiar de pestaña) ===== -->
        <Grid x:Name="PanelHost" Grid.Row="1" SizeChanged="OnPanelHostSizeChanged">

            <!-- ================= INICIO ================= -->
            <ScrollViewer x:Name="HomePanel" VerticalScrollBarVisibility="Hidden">
                <StackPanel Spacing="8" Padding="4,6,4,12">
                    <!-- Juego en primer plano y perfil aplicado -->
                    <Grid ColumnSpacing="12" Margin="2,0,2,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="58" CornerRadius="8" Background="{StaticResource Panel2Brush}">
                            <TextBlock x:Name="HomeGameIcon" Style="{StaticResource IconText}" FontSize="22" Text="&#xE26E;" HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="HomeGameTitle" Text="Sin juego" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="HomeGameSub" Text="Perfil Global" FontSize="12" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>

                    <!-- Aviso de versión nueva: A lleva a Sistema › Actualizaciones; X o ✕ lo ocultan para esa versión -->
                    <Grid x:Name="UpdateNotice" Visibility="Collapsed" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="UpdateNoticeButton" Style="{StaticResource RowButton}" Background="#2EFFB547"
                                Padding="13,8" Click="OnUpdateNoticeClick" AutomationProperties.Name="Versión nueva de GoPilot">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource IconText}" FontSize="18" Text="&#xE030;" Foreground="{StaticResource WarnBrush}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="UpdateNoticeTitle" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="A para ver las novedades · X para ocultar" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button Grid.Column="1" Style="{StaticResource FlatButton}" IsTabStop="False" Width="30" Click="OnUpdateNoticeDismiss"
                                AutomationProperties.Name="Ocultar aviso" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                            <TextBlock Style="{StaticResource IconText}" FontSize="13" Text="&#xE4F6;" />
                        </Button>
                    </Grid>

                    <!-- Brillo y volumen: ◀ ▶ los ajustan directamente (sin «entrar» con A) -->
                    <StackPanel x:Name="QuickSlidersSection" Spacing="8">
                        <Border Tag="row" Background="{StaticResource Panel2Brush}" CornerRadius="14" Padding="13,2,13,2" MinHeight="46">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="42" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource IconText}" FontSize="18" Text="&#xE472;" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Brillo" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource RowTextBrush}" VerticalAlignment="Center" />
                                <Slider x:Name="BrightnessSlider" Grid.Column="2" MinWidth="90" Minimum="0" Maximum="100" StepFrequency="5" SmallChange="10" LargeChange="20"
                                        VerticalAlignment="Center" ValueChanged="OnBrightnessChanged" AutomationProperties.Name="Brillo" />
                                <TextBlock x:Name="BrightnessValue" Grid.Column="3" Style="{StaticResource ValueText}" Text="—" />
                            </Grid>
                        </Border>
                        <Border Tag="row" Background="{StaticResource Panel2Brush}" CornerRadius="14" Padding="13,2,13,2" MinHeight="46">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="42" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource IconText}" FontSize="18" Text="&#xE44A;" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Volumen" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource RowTextBrush}" VerticalAlignment="Center" />
                                <Slider x:Name="VolumeSlider" Grid.Column="2" MinWidth="90" Minimum="0" Maximum="100" StepFrequency="5" SmallChange="5" LargeChange="20"
                                        VerticalAlignment="Center" ValueChanged="OnVolumeChanged" AutomationProperties.Name="Volumen" />
                                <TextBlock x:Name="VolumeValue" Grid.Column="3" Style="{StaticResource ValueText}" Text="—" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Modo: ◀ ▶ (A no cambia nada) -->
                    <c:Tile Row="value" x:Name="HomeModeTile" Glyph="&#xE628;" Title="Modo" Choices="Silencio|Equil.|Rendim.|Manual|Auto" />
                    <!-- Cerrar juego: pulsar dos veces -->
                    <c:Tile Row="value" x:Name="HomeKillTile" Glyph="&#xE4F8;" Title="Cerrar juego" State="Sin juego" Available="False" Click="OnKillClick" />

                </StackPanel>
            </ScrollViewer>

            <!-- ================= RENDIMIENTO ================= -->
            <ScrollViewer x:Name="PowerPanel" VerticalScrollBarVisibility="Hidden" Visibility="Collapsed">
                <StackPanel Spacing="8" Padding="4,6,4,12">
                    <c:Tile Row="value" x:Name="PowerModeTile" Glyph="&#xE628;" Title="Modo" Choices="Silencio|Equil.|Rendim.|Manual|Auto" />
                    <TextBlock x:Name="ModeHint" FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="6,0,6,2"
                               Text="Los vatios cambian si la consola está enchufada. Legion L + Y también cambia de modo." />

                    <!-- AutoTDP: FPS objetivo y margen de vatios; GoPilot ajusta el límite solo (AutoTdp.cs en el agente) -->
                    <StackPanel x:Name="AutoPanel" Spacing="8" Visibility="Collapsed">
                        <Border Background="{StaticResource Panel2Brush}" CornerRadius="14" Padding="13,10,13,12">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <TextBlock VerticalAlignment="Bottom" Margin="0,0,0,3"><Run Text="FPS objetivo" FontSize="13.5" FontWeight="SemiBold" /><Run Text="  reales (AFMF los duplica)" FontSize="11" Foreground="{StaticResource MutedBrush}" /></TextBlock>
                                    <TextBlock x:Name="AutoTargetValue" Text="60" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid x:Name="AutoTargetButtons" ColumnSpacing="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Tag="row" Background="{StaticResource Panel2Brush}" CornerRadius="14" Padding="13,2,13,2" MinHeight="46">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="46" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource IconText}" FontSize="18" Text="&#xE05C;" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Mínimo" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource RowTextBrush}" VerticalAlignment="Center" />
                                <Slider x:Name="AutoMinSlider" Grid.Column="2" MinWidth="90" Minimum="5" Maximum="30" StepFrequency="1" SmallChange="1" VerticalAlignment="Center"
                                        ValueChanged="OnAutoRangeChanged" AutomationProperties.Name="Mínimo de AutoTDP" />
                                <TextBlock x:Name="AutoMinValue" Grid.Column="3" Style="{StaticResource ValueText}" />
                            </Grid>
                        </Border>
                        <Border Tag="row" Background="{StaticResource Panel2Brush}" CornerRadius="14" Padding="13,2,13,2" MinHeight="46">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="46" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource IconText}" FontSize="18" Text="&#xE066;" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Máximo" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource RowTextBrush}" VerticalAlignment="Center" />
                                <Slider x:Name="AutoMaxSlider" Grid.Column="2" MinWidth="90" Minimum="5" Maximum="30" StepFrequency="1" SmallChange="1" VerticalAlignment="Center"
                                        ValueChanged="OnAutoRangeChanged" AutomationProperties.Name="Máximo de AutoTDP" />
                                <TextBlock x:Name="AutoMaxValue" Grid.Column="3" Style="{StaticResource ValueText}" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="AutoLiveText" FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="6,0" />
                        <c:Tile Row="switch" x:Name="AutoChillTile" Glyph="&#xE58C;" Title="Limitar FPS con Radeon Chill" State="—" Click="OnAutoChillClick" />
                    </StackPanel>

                    <!-- Manual, como la Steam Deck: un límite de potencia (SPL); ráfagas (sPPT) y picos (fPPT) se calculan
                         solos por encima. Se aplica medio segundo después de dejar de moverlo. Avanzado: subpágina. -->
                    <StackPanel x:Name="TdpPanel" Spacing="8" Visibility="Collapsed">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="TdpPanelTransform" />
                        </StackPanel.RenderTransform>
                        <Border Tag="row" Background="{StaticResource Panel2Brush}" CornerRadius="14" Padding="13,2,13,2" MinHeight="46">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource IconText}" FontSize="18" Text="&#xE2DE;" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Límite" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource RowTextBrush}" VerticalAlignment="Center" />
                                <Slider x:Name="SplSlider" Grid.Column="2" MinWidth="90" Minimum="5" Maximum="30" StepFrequency="1" SmallChange="1" VerticalAlignment="Center"
                                        ValueChanged="OnTdpSliderChanged" AutomationProperties.Name="Límite de potencia" />
                                <TextBlock Grid.Column="3" VerticalAlignment="Center" MinWidth="42" TextAlignment="Right">
                                    <Run x:Name="SplValue" Text="—" FontSize="14" FontWeight="Bold" /><Run Text=" W" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                </TextBlock>
                            </Grid>
                        </Border>
                        <Grid Margin="6,-2,6,0">
                            <TextBlock x:Name="SplMinText" Text="5 W" FontSize="10.5" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="SplMaxText" Text="30 W" FontSize="10.5" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock x:Name="TdpAutoText" FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="6,0" />
                        <TextBlock x:Name="TdpNowText" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="6,0" />
                        <c:Tile Row="sub" x:Name="TdpAdvancedTile" Glyph="&#xE434;" Title="Avanzado" State="sPPT y fPPT" Click="OnTdpAdvancedClick" />
                        <!-- Subpágina «Avanzado» (se mueve a SubHost al abrirla) -->
                        <StackPanel x:Name="TdpAdvancedBody" Spacing="8" Visibility="Collapsed">
                            <c:Tile Row="switch" x:Name="TdpAutoTile" Glyph="&#xE6A2;" Title="Ráfagas y picos automáticos" State="—" Click="OnTdpAutoClick" />
                            <Border Tag="row" Background="{StaticResource Panel2Brush}" CornerRadius="14" Padding="13,6,13,6" MinHeight="46">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="46" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="sPPT" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource RowTextBrush}" />
                                        <TextBlock Text="ráfagas · hasta 1 min" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                    </StackPanel>
                                    <Slider x:Name="SpptSlider" Grid.Column="1" MinWidth="90" Minimum="5" Maximum="32" StepFrequency="1" SmallChange="1" VerticalAlignment="Center"
                                            ValueChanged="OnTdpSliderChanged" AutomationProperties.Name="sPPT" />
                                    <TextBlock x:Name="SpptValue" Grid.Column="2" Style="{StaticResource ValueText}" />
                                </Grid>
                            </Border>
                            <Border Tag="row" Background="{StaticResource Panel2Brush}" CornerRadius="14" Padding="13,6,13,6" MinHeight="46">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="46" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="fPPT" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource RowTextBrush}" />
                                        <TextBlock Text="picos · fracciones de segundo" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                    </StackPanel>
                                    <Slider x:Name="FpptSlider" Grid.Column="1" MinWidth="90" Minimum="5" Maximum="41" StepFrequency="1" SmallChange="1" VerticalAlignment="Center"
                                            ValueChanged="OnTdpSliderChanged" AutomationProperties.Name="fPPT" />
                                    <TextBlock x:Name="FpptValue" Grid.Column="2" Style="{StaticResource ValueText}" />
                                </Grid>
                            </Border>
                            <TextBlock x:Name="TdpNote" FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}" Visibility="Collapsed" Margin="6,0" />
                        </StackPanel>
                    </StackPanel>

                    <Grid Margin="6,12,6,0">
                        <TextBlock Text="PROCESADOR Y VENTILADOR" Style="{StaticResource GroupTitle}" Margin="0" />
                        <TextBlock x:Name="FanHintText" Text="Curva automática" Style="{StaticResource SectionHint}" />
                    </Grid>
                    <c:Tile Row="switch" x:Name="PowerBoostTile" Glyph="&#xE3FC;" Title="CPU Boost" State="—" Click="OnBoostClick" />
                    <c:Tile Row="switch" x:Name="PowerFanTile" Glyph="&#xE9F2;" Title="Ventilador al máximo" State="—" Click="OnFanClick" />
                    <c:Tile Row="sub" x:Name="FanCurveTile" Glyph="&#xE154;" Title="Curva del ventilador" State="—" Available="False" Click="OnFanCurveOpenClick" />
                    <!-- ===== Subpágina: curva del ventilador (velocidad a 10…100 °C; solo actúa en modo Manual) ===== -->
                    <StackPanel x:Name="FanCurvePage" Spacing="8" Visibility="Collapsed">
                        <c:Tile Row="switch" x:Name="FanCurveSwitchTile" Glyph="&#xE154;" Title="Curva propia" State="—" Click="OnFanCurveClick" />
                        <StackPanel x:Name="FanCurvePanel" Spacing="8" Visibility="Collapsed">
                            <c:Tile Row="value" x:Name="FanPresetTile" Glyph="&#xE434;" Title="Preajuste" Compact="True" />
                            <TextBlock x:Name="FanCurveNote" FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="6,0" />
                            <TextBlock Text="VELOCIDAD SEGÚN LA TEMPERATURA" Style="{StaticResource GroupTitle}" Margin="6,4,6,0" />
                            <StackPanel x:Name="FanCurveSliders" Spacing="8" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="JUEGO" Style="{StaticResource GroupTitle}" />
                    <c:Tile Row="switch" x:Name="AmdChillTile" Glyph="&#xE58C;" Title="Límite de FPS (Chill)" State="—" Available="False" Tag="chill" Click="OnAmdClick" />
                    <!-- Radeon Chill: FPS mínimos (en reposo) y máximos (en acción); visible con Chill activado -->
                    <StackPanel x:Name="ChillPanel" Spacing="8" Visibility="Collapsed">
                        <Border Tag="row" Background="{StaticResource Panel2Brush}" CornerRadius="14" Padding="13,2,13,2" MinHeight="46">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource IconText}" FontSize="18" Text="&#xE05C;" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="FPS mínimos" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource RowTextBrush}" VerticalAlignment="Center" />
                                <Slider x:Name="ChillMinSlider" Grid.Column="2" MinWidth="90" StepFrequency="5" SmallChange="5" VerticalAlignment="Center"
                                        ValueChanged="OnChillSliderChanged" AutomationProperties.Name="FPS mínimos de Chill" />
                                <TextBlock x:Name="ChillMinValue" Grid.Column="3" Style="{StaticResource ValueText}" />
                            </Grid>
                        </Border>
                        <Border Tag="row" Background="{StaticResource Panel2Brush}" CornerRadius="14" Padding="13,2,13,2" MinHeight="46">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource IconText}" FontSize="18" Text="&#xE066;" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="FPS máximos" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource RowTextBrush}" VerticalAlignment="Center" />
                                <Slider x:Name="ChillMaxSlider" Grid.Column="2" MinWidth="90" StepFrequency="5" SmallChange="5" VerticalAlignment="Center"
                                        ValueChanged="OnChillSliderChanged" AutomationProperties.Name="FPS máximos de Chill" />
                                <TextBlock x:Name="ChillMaxValue" Grid.Column="3" Style="{StaticResource ValueText}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                    <c:Tile Row="switch" x:Name="HomeLosslessTile" Glyph="&#xE1CA;" Title="Lossless Scaling" State="—" Available="False" Click="OnLosslessClick" />
                    <c:Tile Row="sub" x:Name="OverlayOpenTile" Glyph="&#xE464;" Title="Overlay en juegos" State="—" Click="OnOverlayOpenClick" />
                    <!-- ===== Subpágina: overlay propio (No / En juegos / Siempre, qué muestra y dónde) ===== -->
                    <StackPanel x:Name="OverlayPage" Spacing="8" Visibility="Collapsed">
                        <c:Tile Row="value" x:Name="GameOverlayTile" Glyph="&#xE464;" Title="Overlay" Choices="No|En juegos|Siempre" />
                        <StackPanel Spacing="8" x:Name="OverlaySettings" Visibility="Collapsed">
                            <c:Tile Row="value" x:Name="OverlayContentTile" Glyph="&#xE154;" Title="Mostrar" Compact="True" />
                            <c:Tile Row="value" x:Name="OverlayPositionTile" Glyph="&#xE626;" Title="Posición" Compact="True" />
                        </StackPanel>
                        <TextBlock Text="Lo dibuja GoPilot encima del juego, sin fijar widgets en Game Bar." FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedBrush}" Margin="6,0" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= PANTALLA ================= -->
            <ScrollViewer x:Name="DisplayPanel" VerticalScrollBarVisibility="Hidden" Visibility="Collapsed">
                <StackPanel Spacing="8" Padding="4,6,4,12">
                    <c:Tile Row="value" x:Name="ResolutionTile" Glyph="&#xE0A2;" Title="Resolución" Compact="True" />
                    <c:Tile Row="value" x:Name="HzTile" Glyph="&#xE094;" Title="Refresco" />
                    <!-- VRR: FreeSync de AMD; al encenderlo el agente activa también el ajuste de Windows para juegos en ventana -->
                    <c:Tile Row="switch" x:Name="AmdFreeSyncTile" Glyph="&#xEA9A;" Title="VRR (FreeSync)" State="—" Available="False" Tag="freesync" Click="OnAmdClick" />

                    <Grid Margin="6,12,6,0">
                        <TextBlock Text="AMD RADEON" Style="{StaticResource GroupTitle}" Margin="0" />
                        <TextBlock Text="sin abrir Adrenalin" Style="{StaticResource SectionHint}" />
                    </Grid>
                    <c:Tile Row="switch" x:Name="AmdAfmfTile" Glyph="&#xE792;" Title="AFMF" State="—" Available="False" Tag="afmf" Click="OnAmdClick" />
                    <c:Tile Row="switch" x:Name="AmdRsrTile" Glyph="&#xE626;" Title="RSR" State="—" Available="False" Tag="rsr" Click="OnAmdClick" />
                    <c:Tile Row="switch" x:Name="AmdSharpTile" Glyph="&#xE210;" Title="Nitidez" State="—" Available="False" Tag="sharpening" Click="OnAmdClick" />
                    <c:Tile Row="switch" x:Name="AmdAntiLagTile" Glyph="&#xE492;" Title="Anti-Lag" State="—" Available="False" Tag="antilag" Click="OnAmdClick" />
                    <c:Tile Row="switch" x:Name="AmdVariBrightTile" Glyph="&#xE474;" Title="Vari-Bright" State="—" Available="False" Tag="varibright" Click="OnAmdClick" />
                    <TextBlock Text="El límite de FPS (Radeon Chill) está en Rendimiento › Juego." FontSize="11.5" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}" Margin="6,4,6,0" />
                </StackPanel>
            </ScrollViewer>

            <!-- ================= MANDO ================= -->
            <ScrollViewer x:Name="DevicePanel" VerticalScrollBarVisibility="Hidden" Visibility="Collapsed">
                <StackPanel Spacing="8" Padding="4,6,4,12">
                    <c:Tile Row="switch" x:Name="DeviceLightsTile" Glyph="&#xE2DC;" Title="Luces" State="—" Available="False" Click="OnLightsClick" />
                    <c:Tile Row="value" x:Name="VibrationTile" Glyph="&#xE4D8;" Title="Vibración del mando" Choices="No|Suave|Media|Fuerte" Available="False" />
                    <c:Tile Row="value" x:Name="TouchVibrationTile" Glyph="&#xE4D8;" Title="Vibración touchpad" Choices="No|Suave|Media|Fuerte" Available="False" />
                    <c:Tile Row="switch" x:Name="DeviceTouchpadTile" Glyph="&#xE29A;" Title="Touchpad" State="—" Click="OnTouchpadClick" />
                    <c:Tile Row="switch" x:Name="TouchscreenTile" Glyph="&#xEC90;" Title="Pantalla táctil" State="—" Available="False" Click="OnTouchscreenClick" />
                    <c:Tile Row="switch" x:Name="GyroTile" Glyph="&#xE1C8;" Title="Giroscopio" State="—" Available="False" Click="OnGyroClick" />

                    <Grid Margin="6,12,6,0">
                        <TextBlock Text="AJUSTES DEL MANDO" Style="{StaticResource GroupTitle}" Margin="0" />
                        <TextBlock Text="guardados en el propio mando" Style="{StaticResource SectionHint}" />
                    </Grid>
                    <c:Tile Row="value" x:Name="AutoSleepTile" Glyph="&#xE330;" Title="Apagado automático" Compact="True" Choices="Nunca|5 min|10 min|15 min|30 min|60 min" Available="False" />
                    <c:Tile Row="value" x:Name="PollRateTile" Glyph="&#xE000;" Title="Frecuencia de sondeo" Compact="True" Choices="125 Hz|250 Hz|500 Hz|1000 Hz" Available="False" />
                    <c:Tile Row="value" x:Name="DpadTile" Glyph="&#xE0A4;" Title="Cruceta" Choices="8 dir.|4 dir." Available="False" />

                    <!-- Ajustes avanzados: cada fila abre su subpágina (A entra, B vuelve) -->
                    <StackPanel x:Name="AdvancedSection" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="AJUSTES AVANZADOS" Style="{StaticResource GroupTitle}" />
                        <c:Tile Row="sub" x:Name="AdvLightsTile" Glyph="&#xE6C8;" Title="Luces de los sticks" State="—" Tag="lights" Click="OnAdvancedTabClick" />
                        <c:Tile Row="sub" x:Name="AdvSticksTile" Glyph="&#xEA5E;" Title="Sticks" State="Zonas muertas" Tag="sticks" Click="OnAdvancedTabClick" />
                        <c:Tile Row="sub" x:Name="AdvTriggersTile" Glyph="&#xE29A;" Title="Gatillos" State="Recorrido" Tag="triggers" Click="OnAdvancedTabClick" />
                        <c:Tile Row="sub" x:Name="AdvGyroTile" Glyph="&#xE1C8;" Title="Giroscopio" State="—" Tag="gyro" Click="OnAdvancedTabClick" />

                        <!-- ===== Subpágina: Sticks ===== -->
                        <StackPanel x:Name="SticksPanel" Spacing="8" Visibility="Collapsed">
                            <Grid x:Name="SticksTest" ColumnSpacing="14" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="110" Height="110" HorizontalAlignment="Center">
                                    <Ellipse Stroke="{StaticResource LineBrush}" StrokeThickness="2" Fill="{StaticResource Panel2Brush}" />
                                    <Ellipse x:Name="LeftStickDot" Width="18" Height="18" Fill="White">
                                        <Ellipse.RenderTransform><TranslateTransform x:Name="LeftStickMove" /></Ellipse.RenderTransform>
                                    </Ellipse>
                                </Grid>
                                <Grid Grid.Column="1" Width="110" Height="110" HorizontalAlignment="Center">
                                    <Ellipse Stroke="{StaticResource LineBrush}" StrokeThickness="2" Fill="{StaticResource Panel2Brush}" />
                                    <Ellipse x:Name="RightStickDot" Width="18" Height="18" Fill="White">
                                        <Ellipse.RenderTransform><TranslateTransform x:Name="RightStickMove" /></Ellipse.RenderTransform>
                                    </Ellipse>
                                </Grid>
                            </Grid>
                            <TextBlock Text="ZONAS MUERTAS" Style="{StaticResource GroupTitle}" Margin="6,4,6,0" />
                            <Border Tag="row" Background="{StaticResource Panel2Brush}" CornerRadius="14" Padding="13,2,13,2" MinHeight="46">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="46" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Izquierdo · centro" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource RowTextBrush}" VerticalAlignment="Center" />
                                    <Slider x:Name="LsCenterSlider" Grid.Column="1" MinWidth="80" Minimum="0" Maximum="40" StepFrequency="1" SmallChange="1" VerticalAlignment="Center" ValueChanged="OnDeadzoneChanged" AutomationProperties.Name="Izquierdo · centro" />
                                    <TextBlock x:Name="LsCenterValue" Grid.Column="2" Style="{StaticResource ValueText}" />
                                </Grid>
                            </Border>
                            <Border Tag="row" Background="{StaticResource Panel2Brush}" CornerRadius="14" Padding="13,2,13,2" MinHeight="46">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="46" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Derecho · centro" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource RowTextBrush}" VerticalAlignment="Center" />
                                    <Slider x:Name="RsCenterSlider" Grid.Column="1" MinWidth="80" Minimum="0" Maximum="40" StepFrequency="1" SmallChange="1" VerticalAlignment="Center" ValueChanged="OnDeadzoneChanged" AutomationProperties.Name="Derecho · centro" />
                                    <TextBlock x:Name="RsCenterValue" Grid.Column="2" Style="{StaticResource ValueText}" />
                                </Grid>
                            </Border>
                            <Border Tag="row" Background="{StaticResource Panel2Brush}" CornerRadius="14" Padding="13,2,13,2" MinHeight="46">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="46" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Izquierdo · borde" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource RowTextBrush}" VerticalAlignment="Center" />
                                    <Slider x:Name="LsEdgeSlider" Grid.Column="1" MinWidth="80" Minimum="60" Maximum="100" StepFrequency="1" SmallChange="1" VerticalAlignment="Center" ValueChanged="OnDeadzoneChanged" AutomationProperties.Name="Izquierdo · borde" />
                                    <TextBlock x:Name="LsEdgeValue" Grid.Column="2" Style="{StaticResource ValueText}" />
                                </Grid>
                            </Border>
                            <Border Tag="row" Background="{StaticResource Panel2Brush}" CornerRadius="14" Padding="13,2,13,2" MinHeight="46">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="46" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Derecho · borde" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource RowTextBrush}" VerticalAlignment="Center" />
                                    <Slider x:Name="RsEdgeSlider" Grid.Column="1" MinWidth="80" Minimum="60" Maximum="100" StepFrequency="1" SmallChange="1" VerticalAlignment="Center" ValueChanged="OnDeadzoneChanged" AutomationProperties.Name="Derecho · borde" />
                                    <TextBlock x:Name="RsEdgeValue" Grid.Column="2" Style="{StaticResource ValueText}" />
                                </Grid>
                            </Border>
                            <Grid ColumnSpacing="6" Margin="0,4,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Button x:Name="CalSticksButton" Grid.Column="0" Style="{StaticResource RowButton}" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Tag="sticks" Click="OnCalibrateClick">
                                    <TextBlock Text="Calibrar" FontSize="13" FontWeight="SemiBold" />
                                </Button>
                                <Button x:Name="TestSticksButton" Grid.Column="1" Style="{StaticResource RowButton}" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Tag="sticks" Click="OnTestClick">
                                    <TextBlock Text="Probar" FontSize="13" FontWeight="SemiBold" />
                                </Button>
                                <Button x:Name="DefSticksButton" Grid.Column="2" Style="{StaticResource RowButton}" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Tag="sticks" Click="OnDefaultsClick">
                                    <TextBlock Text="Por defecto" FontSize="13" FontWeight="SemiBold" />
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- ===== Subpágina: Gatillos ===== -->
                        <StackPanel x:Name="TriggersPanel" Spacing="8" Visibility="Collapsed">
                            <StackPanel x:Name="TriggersTest" Spacing="8" Margin="6,0" Visibility="Collapsed">
                                <StackPanel Spacing="3">
                                    <Grid>
                                        <TextBlock Text="Gatillo izquierdo" FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock x:Name="LeftTriggerText" Style="{StaticResource ValueText}" FontSize="12" />
                                    </Grid>
                                    <Grid Height="10" CornerRadius="5" Background="{StaticResource TrackBrush}">
                                        <Border x:Name="LeftTriggerFill" HorizontalAlignment="Left" Width="0" CornerRadius="5" Background="White" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Spacing="3">
                                    <Grid>
                                        <TextBlock Text="Gatillo derecho" FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock x:Name="RightTriggerText" Style="{StaticResource ValueText}" FontSize="12" />
                                    </Grid>
                                    <Grid Height="10" CornerRadius="5" Background="{StaticResource TrackBrush}">
                                        <Border x:Name="RightTriggerFill" HorizontalAlignment="Left" Width="0" CornerRadius="5" Background="White" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="RECORRIDO" Style="{StaticResource GroupTitle}" Margin="6,4,6,0" />
                            <Border Tag="row" Background="{StaticResource Panel2Brush}" CornerRadius="14" Padding="13,2,13,2" MinHeight="46">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="46" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Izquierdo · inicio" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource RowTextBrush}" VerticalAlignment="Center" />
                                    <Slider x:Name="LtLowSlider" Grid.Column="1" MinWidth="80" Minimum="0" Maximum="40" StepFrequency="1" SmallChange="1" VerticalAlignment="Center" ValueChanged="OnDeadzoneChanged" AutomationProperties.Name="Izquierdo · inicio" />
                                    <TextBlock x:Name="LtLowValue" Grid.Column="2" Style="{StaticResource ValueText}" />
                                </Grid>
                            </Border>
                            <Border Tag="row" Background="{StaticResource Panel2Brush}" CornerRadius="14" Padding="13,2,13,2" MinHeight="46">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="46" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Derecho · inicio" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource RowTextBrush}" VerticalAlignment="Center" />
                                    <Slider x:Name="RtLowSlider" Grid.Column="1" MinWidth="80" Minimum="0" Maximum="40" StepFrequency="1" SmallChange="1" VerticalAlignment="Center" ValueChanged="OnDeadzoneChanged" AutomationProperties.Name="Derecho · inicio" />
                                    <TextBlock x:Name="RtLowValue" Grid.Column="2" Style="{StaticResource ValueText}" />
                                </Grid>
                            </Border>
                            <Border Tag="row" Background="{StaticResource Panel2Brush}" CornerRadius="14" Padding="13,2,13,2" MinHeight="46">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="46" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Izquierdo · fin" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource RowTextBrush}" VerticalAlignment="Center" />
                                    <Slider x:Name="LtHighSlider" Grid.Column="1" MinWidth="80" Minimum="60" Maximum="100" StepFrequency="1" SmallChange="1" VerticalAlignment="Center" ValueChanged="OnDeadzoneChanged" AutomationProperties.Name="Izquierdo · fin" />
                                    <TextBlock x:Name="LtHighValue" Grid.Column="2" Style="{StaticResource ValueText}" />
                                </Grid>
                            </Border>
                            <Border Tag="row" Background="{StaticResource Panel2Brush}" CornerRadius="14" Padding="13,2,13,2" MinHeight="46">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="46" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Derecho · fin" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource RowTextBrush}" VerticalAlignment="Center" />
                                    <Slider x:Name="RtHighSlider" Grid.Column="1" MinWidth="80" Minimum="60" Maximum="100" StepFrequency="1" SmallChange="1" VerticalAlignment="Center" ValueChanged="OnDeadzoneChanged" AutomationProperties.Name="Derecho · fin" />
                                    <TextBlock x:Name="RtHighValue" Grid.Column="2" Style="{StaticResource ValueText}" />
                                </Grid>
                            </Border>
                            <Grid ColumnSpacing="6" Margin="0,4,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Button x:Name="CalTriggersButton" Grid.Column="0" Style="{StaticResource RowButton}" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Tag="triggers" Click="OnCalibrateClick">
                                    <TextBlock Text="Calibrar" FontSize="13" FontWeight="SemiBold" />
                                </Button>
                                <Button x:Name="TestTriggersButton" Grid.Column="1" Style="{StaticResource RowButton}" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Tag="triggers" Click="OnTestClick">
                                    <TextBlock Text="Probar" FontSize="13" FontWeight="SemiBold" />
                                </Button>
                                <Button x:Name="DefTriggersButton" Grid.Column="2" Style="{StaticResource RowButton}" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Tag="triggers" Click="OnDefaultsClick">
                                    <TextBlock Text="Por defecto" FontSize="13" FontWeight="SemiBold" />
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- ===== Subpágina: Giroscopio ===== -->
                        <StackPanel x:Name="GyroPanel" Spacing="8" Visibility="Collapsed">
                            <c:Tile Row="value" x:Name="GyroModeTile" Glyph="&#xE1C8;" Title="Usar el giroscopio como" Compact="True" Choices="Desactivado|Ratón|Stick izquierdo|Stick derecho" />
                            <Border x:Name="GyroSensitivityRow" Tag="row" Background="{StaticResource Panel2Brush}" CornerRadius="14" Padding="13,2,13,2" MinHeight="46">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Sensibilidad" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource RowTextBrush}" VerticalAlignment="Center" />
                                    <Slider x:Name="GyroSensitivitySlider" Grid.Column="1" MinWidth="90" Minimum="1" Maximum="100" StepFrequency="1" SmallChange="5" VerticalAlignment="Center"
                                            ValueChanged="OnGyroSensitivityChanged" AutomationProperties.Name="Sensibilidad del giroscopio" />
                                    <TextBlock x:Name="GyroSensitivityValue" Grid.Column="2" Style="{StaticResource ValueText}" />
                                </Grid>
                            </Border>
                            <Grid x:Name="GyroTest" Height="110" CornerRadius="14" Background="{StaticResource Panel2Brush}" Visibility="Collapsed">
                                <TextBlock Text="Mueve la consola" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="12,8" />
                                <Ellipse x:Name="GyroDot" Width="18" Height="18" Fill="White">
                                    <Ellipse.RenderTransform><TranslateTransform x:Name="GyroMove" /></Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                            <Grid ColumnSpacing="6" Margin="0,4,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Button x:Name="CalGyroButton" Grid.Column="0" Style="{StaticResource RowButton}" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Tag="gyro" Click="OnCalibrateClick">
                                    <TextBlock Text="Calibrar" FontSize="13" FontWeight="SemiBold" />
                                </Button>
                                <Button x:Name="TestGyroButton" Grid.Column="1" Style="{StaticResource RowButton}" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Tag="gyro" Click="OnTestClick">
                                    <TextBlock Text="Probar" FontSize="13" FontWeight="SemiBold" />
                                </Button>
                                <Button x:Name="DefGyroButton" Grid.Column="2" Style="{StaticResource RowButton}" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Tag="gyro" Click="OnDefaultsClick">
                                    <TextBlock Text="Por defecto" FontSize="13" FontWeight="SemiBold" />
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- ===== Subpágina: Luces de los sticks (color, efecto, brillo y velocidad) ===== -->
                        <StackPanel x:Name="LightsPanel" Spacing="8" Visibility="Collapsed">
                            <TextBlock x:Name="LightsOffText" FontSize="12.5" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="6,0"
                                       Text="Las luces están apagadas: enciéndelas con la fila «Luces» de Mando." />
                            <StackPanel x:Name="LightsSettings" Spacing="8">
                                <c:Tile Row="value" x:Name="EffectTile" Glyph="&#xE6A2;" Title="Efecto" Compact="True" Choices="Fijo|Respiración|Croma|Arcoíris|Reactivo" />
                                <Border x:Name="LightBrightnessRow" Tag="row" Background="{StaticResource Panel2Brush}" CornerRadius="14" Padding="13,2,13,2" MinHeight="46">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="46" /></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource IconText}" FontSize="18" Text="&#xE472;" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="Brillo" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource RowTextBrush}" VerticalAlignment="Center" />
                                        <Slider x:Name="LightBrightnessSlider" Grid.Column="2" MinWidth="90" Minimum="10" Maximum="100" StepFrequency="10" SmallChange="10" VerticalAlignment="Center"
                                                ValueChanged="OnLightSliderChanged" AutomationProperties.Name="Brillo de las luces" />
                                        <TextBlock x:Name="LightBrightnessValue" Grid.Column="3" Style="{StaticResource ValueText}" />
                                    </Grid>
                                </Border>
                                <!-- Reactivo: brillo en reposo y en los golpes del sonido -->
                                <StackPanel x:Name="ReactiveRows" Spacing="8" Visibility="Collapsed">
                                    <Border Tag="row" Background="{StaticResource Panel2Brush}" CornerRadius="14" Padding="13,2,13,2" MinHeight="46">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="46" /></Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource IconText}" FontSize="18" Text="&#xE474;" HorizontalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="Reposo" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource RowTextBrush}" VerticalAlignment="Center" />
                                            <Slider x:Name="ReactiveLowSlider" Grid.Column="2" MinWidth="90" Minimum="0" Maximum="60" StepFrequency="5" SmallChange="5" VerticalAlignment="Center"
                                                    ValueChanged="OnLightSliderChanged" AutomationProperties.Name="Brillo en reposo" />
                                            <TextBlock x:Name="ReactiveLowValue" Grid.Column="3" Style="{StaticResource ValueText}" />
                                        </Grid>
                                    </Border>
                                    <Border Tag="row" Background="{StaticResource Panel2Brush}" CornerRadius="14" Padding="13,2,13,2" MinHeight="46">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="46" /></Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource IconText}" FontSize="18" Text="&#xE472;" HorizontalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="Pico" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource RowTextBrush}" VerticalAlignment="Center" />
                                            <Slider x:Name="ReactiveHighSlider" Grid.Column="2" MinWidth="90" Minimum="30" Maximum="100" StepFrequency="5" SmallChange="5" VerticalAlignment="Center"
                                                    ValueChanged="OnLightSliderChanged" AutomationProperties.Name="Brillo en los golpes" />
                                            <TextBlock x:Name="ReactiveHighValue" Grid.Column="3" Style="{StaticResource ValueText}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <Border x:Name="LightSpeedRow" Tag="row" Background="{StaticResource Panel2Brush}" CornerRadius="14" Padding="13,2,13,2" MinHeight="46">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="46" /></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource IconText}" FontSize="18" Text="&#xE492;" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="Velocidad" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource RowTextBrush}" VerticalAlignment="Center" />
                                        <Slider x:Name="LightSpeedSlider" Grid.Column="2" MinWidth="90" Minimum="0" Maximum="100" StepFrequency="10" SmallChange="10" VerticalAlignment="Center"
                                                ValueChanged="OnLightSliderChanged" AutomationProperties.Name="Velocidad del efecto" />
                                        <TextBlock x:Name="LightSpeedValue" Grid.Column="3" Style="{StaticResource ValueText}" />
                                    </Grid>
                                </Border>
                                <StackPanel Spacing="4" Margin="6,2,6,0">
                                    <TextBlock Text="Color" FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
                                    <VariableSizedWrapGrid x:Name="ColorSwatches" Orientation="Horizontal" MaximumRowsOrColumns="10"
                                                           ItemWidth="30" ItemHeight="30" HorizontalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Instrucciones mientras se calibra (va a la subpágina junto con sticks, gatillos o giroscopio) -->
                        <StackPanel x:Name="CalibrationPanel" Spacing="8" Margin="6,6,6,0" Visibility="Collapsed">
                            <TextBlock x:Name="CalibrationText" FontSize="12.5" TextWrapping="Wrap" />
                            <Button x:Name="CalibrationDoneButton" Style="{StaticResource RowButton}" Background="White" Height="40"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnCalibrationDoneClick">
                                <TextBlock Text="Terminar" FontSize="13" FontWeight="SemiBold" Foreground="#FF111111" />
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Botones Legion: una fila que abre su subpágina (para no alargar Mando) -->
                    <TextBlock Text="BOTONES LEGION" Style="{StaticResource GroupTitle}" />
                    <c:Tile Row="sub" x:Name="ButtonsOpenTile" Glyph="&#xE26E;" Title="Botones Legion" State="—" Click="OnButtonsOpenClick" />
                    <!-- ===== Subpágina: Botones Legion (L / R, mantenidos y atajos avanzados) ===== -->
                    <StackPanel x:Name="ButtonsPage" Spacing="8" Visibility="Collapsed">
                        <!-- Se usan juntos: GoPilot atiende los botones y Legion Space debe estar desactivado para que no responda también -->
                        <c:Tile Row="switch" x:Name="ButtonsTile" Glyph="&#xE26E;" Title="Botones Legion con GoPilot" State="—" Click="OnButtonsToggleClick" />
                        <TextBlock x:Name="ButtonsHint" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="6,0" />
                        <StackPanel x:Name="ButtonsBody" Spacing="8" Margin="6,0,6,0" Visibility="Collapsed">
                            <TextBlock x:Name="ButtonsWarning" Visibility="Collapsed" FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}"
                                       Text="Legion Space sigue activo y también responde a Legion L / R: desactívalo en Sistema › Legion Space." />
                        </StackPanel>
                        <!-- Legion L / R y mantenidos: ◀ ▶ eligen la acción -->
                        <StackPanel x:Name="ButtonsList" Spacing="8" />
                        <!-- Combinaciones Legion + botón (ocultas salvo que se activen) -->
                        <StackPanel x:Name="AdvancedButtonsCard" Spacing="8">
                            <TextBlock Text="ATAJOS AVANZADOS" Style="{StaticResource GroupTitle}" />
                            <c:Tile Row="switch" x:Name="AdvancedButtonsTile" Glyph="&#xE1C4;" Title="Atajos avanzados" State="—" Click="OnAdvancedButtonsClick" />
                            <StackPanel x:Name="AdvancedButtonsList" Spacing="8" Visibility="Collapsed" />
                            <TextBlock Text="L+Y, L+X, L+A, L+B y L+LB los hace el firmware del mando y no se pueden cambiar." FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedBrush}" Margin="6,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Modo escritorio (como la Steam Deck): el mando hace de ratón cuando no hay juego delante -->
                    <Grid Margin="6,12,6,0">
                        <TextBlock Text="MODO ESCRITORIO" Style="{StaticResource GroupTitle}" Margin="0" />
                        <TextBlock Text="mando como ratón" Style="{StaticResource SectionHint}" />
                    </Grid>
                    <c:Tile Row="value" x:Name="DesktopTile" Glyph="&#xE33A;" Title="Modo escritorio" Choices="Apagado|Auto|Siempre" />
                    <Border Tag="row" Background="{StaticResource Panel2Brush}" CornerRadius="14" Padding="13,2,13,2" MinHeight="46">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="36" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource IconText}" FontSize="18" Text="&#xE33A;" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Ratón" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource RowTextBrush}" VerticalAlignment="Center" />
                            <Slider x:Name="DesktopPointerSlider" Grid.Column="2" MinWidth="90" Minimum="1" Maximum="100" StepFrequency="1" SmallChange="5" VerticalAlignment="Center"
                                    ValueChanged="OnDesktopSliderChanged" AutomationProperties.Name="Velocidad del ratón" />
                            <TextBlock x:Name="DesktopPointerValue" Grid.Column="3" Style="{StaticResource ValueText}" />
                        </Grid>
                    </Border>
                    <Border Tag="row" Background="{StaticResource Panel2Brush}" CornerRadius="14" Padding="13,2,13,2" MinHeight="46">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="36" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource IconText}" FontSize="18" Text="&#xE0A4;" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Desplazar" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource RowTextBrush}" VerticalAlignment="Center" />
                            <Slider x:Name="DesktopScrollSlider" Grid.Column="2" MinWidth="90" Minimum="1" Maximum="100" StepFrequency="1" SmallChange="5" VerticalAlignment="Center"
                                    ValueChanged="OnDesktopSliderChanged" AutomationProperties.Name="Velocidad del desplazamiento" />
                            <TextBlock x:Name="DesktopScrollValue" Grid.Column="3" Style="{StaticResource ValueText}" />
                        </Grid>
                    </Border>
                    <Border Background="{StaticResource Panel2Brush}" CornerRadius="14" Padding="13,10" Opacity="0.85">
                        <Grid ColumnSpacing="12" RowSpacing="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Stick derecho" FontSize="11.5" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="Mover el ratón" FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Grid.Row="1" Text="RT · LT" FontSize="11.5" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Clic izquierdo · clic derecho" FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Grid.Row="2" Text="Stick izquierdo" FontSize="11.5" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Desplazar (rueda)" FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Grid.Row="3" Text="A · B" FontSize="11.5" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="Intro · Esc" FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Grid.Row="4" Text="X · Y" FontSize="11.5" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="Teclado en pantalla · vista de tareas" FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Grid.Row="5" Text="LB · RB" FontSize="11.5" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="Pestaña anterior · siguiente" FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
                        </Grid>
                    </Border>
                    <TextBlock FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="6,0"
                               Text="Automático: se activa sin juego delante y se apaga al abrir uno. Para escribir con el mando, en el teclado en pantalla elige una vez ⚙ › Distribución de teclado › Controlador para juegos." />

                    <TextBlock Text="RESTABLECER" Style="{StaticResource GroupTitle}" />
                    <Button x:Name="FactoryResetButton" Style="{StaticResource RowButton}" MinHeight="46" Padding="13,0"
                            HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Click="OnFactoryResetClick">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Style="{StaticResource IconText}" FontSize="18" Width="22" Text="&#xE038;" Foreground="#FFFF8A80" />
                            <TextBlock x:Name="FactoryResetText" Text="Restablecer el mando de fábrica" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFF8A80" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= SISTEMA ================= -->
            <ScrollViewer x:Name="ProfilesPanel" VerticalScrollBarVisibility="Hidden" Visibility="Collapsed">
                <StackPanel Spacing="8" Padding="4,6,4,12">
                    <c:Tile Row="switch" x:Name="ChargeTile" Glyph="&#xE0BA;" Title="Cargar solo hasta el 80 %" State="—" Click="OnChargeClick" />
                    <TextBlock x:Name="BatteryHealthText" FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="6,0" />
                    <c:Tile Row="value" x:Name="HomeKeyboardTile" Glyph="&#xE2D8;" Title="Teclado en pantalla" State="Abrir" Click="OnKeyboardClick" />

                    <TextBlock Text="GOPILOT" Style="{StaticResource GroupTitle}" />
                    <c:Tile Row="switch" x:Name="AnimationsTile" Glyph="&#xE6A2;" Title="Animaciones" State="—" Click="OnAnimationsClick" />
                    <c:Tile Row="switch" x:Name="SoundsTile" Glyph="&#xE450;" Title="Sonidos" State="—" Click="OnSoundsClick" />

                    <Grid Margin="6,12,6,0">
                        <TextBlock Text="PERFILES" Style="{StaticResource GroupTitle}" Margin="0" />
                        <TextBlock x:Name="ProfileCountText" Style="{StaticResource SectionHint}" />
                    </Grid>
                    <c:Tile Row="switch" x:Name="AutoProfilesTile" Glyph="&#xE756;" Title="Aplicar perfiles automáticamente" State="—" Click="OnAutoProfilesClick" />
                    <c:Tile Row="switch" x:Name="AutoSaveTile" Glyph="&#xE248;" Title="Guardar cambios automáticamente" State="—" Click="OnAutoSaveClick" />
                    <StackPanel x:Name="ProfilesList" Spacing="6" />
                    <TextBlock x:Name="ProfilesEmptyText" FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="6,0"
                               Text="Abre un juego, ajusta modo, TDP, pantalla y Lossless a tu gusto: la próxima vez se aplicará solo y, al cerrar el juego, volverás a Global." />

                    <TextBlock Text="COMPORTAMIENTO" Style="{StaticResource GroupTitle}" />
                    <c:Tile Row="switch" x:Name="ResumeTile" Glyph="&#xE58E;" Title="Reaplicar ajustes tras suspender" State="—" Click="OnResumeClick" />
                    <c:Tile Row="value" x:Name="RefreshRateTile" Glyph="&#xE094;" Title="Actualizar datos cada" Choices="1 s|2 s|5 s" />

                    <StackPanel x:Name="UpdatesSection" Spacing="8">
                        <Grid Margin="6,12,6,0">
                            <TextBlock Text="ACTUALIZACIONES" Style="{StaticResource GroupTitle}" Margin="0" />
                            <TextBlock x:Name="UpdateHint" Style="{StaticResource SectionHint}" />
                        </Grid>
                        <c:Tile Row="value" x:Name="UpdateTile" Glyph="&#xE030;" Title="GoPilot" State="—" Click="OnUpdateTileClick" />
                        <!-- Si hay una versión nueva: novedades y botones -->
                        <StackPanel x:Name="UpdateBody" Spacing="8" Visibility="Collapsed">
                            <Border x:Name="UpdateNotesBox" Background="{StaticResource Panel2Brush}" CornerRadius="14" Padding="13,10" Opacity="0.85">
                                <TextBlock x:Name="UpdateNotes" FontSize="12" TextWrapping="Wrap" />
                            </Border>
                            <ProgressBar x:Name="UpdateProgress" Maximum="100" Height="4" Foreground="White" Visibility="Collapsed" />
                            <TextBlock x:Name="UpdateMessage" FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Visibility="Collapsed" Margin="6,0" />
                            <Grid x:Name="UpdateButtons" ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="UpdateNowButton" Style="{StaticResource RowButton}" Background="White" Foreground="#FF111111" Height="40" FontSize="13" FontWeight="SemiBold"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Content="Actualizar" Click="OnUpdateNowClick" />
                                <Button x:Name="UpdateLaterButton" Grid.Column="1" Style="{StaticResource RowButton}" Height="40"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnUpdateLaterClick">
                                    <TextBlock Text="Más tarde" FontSize="13" FontWeight="SemiBold" />
                                </Button>
                            </Grid>
                        </StackPanel>
                        <c:Tile Row="switch" x:Name="AutoUpdateTile" Glyph="&#xE094;" Title="Buscar automáticamente" State="—" Click="OnAutoUpdateClick" />
                        <c:Tile Row="value" x:Name="UninstallTile" Glyph="&#xE4A6;" Title="Desinstalar GoPilot" State="" Click="OnUninstallClick" />
                        <TextBlock x:Name="AboutText" FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="6,0" />
                        <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="11.5" IsTextSelectionEnabled="True" Margin="6,0"
                                   Foreground="{StaticResource MutedBrush}" MaxLines="12" />
                    </StackPanel>

                    <!-- Abajo del todo, lejos del resto, para no activarlo sin querer -->
                    <TextBlock Text="LEGION SPACE" Style="{StaticResource GroupTitle}" Margin="6,20,6,0" />
                    <c:Tile Row="switch" x:Name="LegionSpaceTile" Glyph="&#xE3DE;" Title="Legion Space" State="—" Available="False" Click="OnLegionSpaceClick" />
                    <TextBlock Text="Si lo activas, Legion Space vuelve a responder a Legion L / R junto a GoPilot." FontSize="11.5" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}" Margin="6,0" />
                </StackPanel>
            </ScrollViewer>

            <!-- ================= SUBPÁGINA (Avanzado, sticks, gatillos, giroscopio, luces) =================
                 Su contenido se mueve aquí desde su pestaña al abrirla y vuelve a su sitio al cerrarla (B). -->
            <ScrollViewer x:Name="SubPanel" VerticalScrollBarVisibility="Hidden" Visibility="Collapsed">
                <StackPanel Spacing="8" Padding="4,2,4,12">
                    <Button x:Name="SubBackButton" Style="{StaticResource FlatButton}" IsTabStop="False" HorizontalAlignment="Left" Padding="2,4,10,6" Click="OnSubBackClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Style="{StaticResource IconText}" FontSize="16" Text="&#xE138;" />
                            <TextBlock x:Name="SubTitleText" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock x:Name="SubFromText" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <StackPanel x:Name="SubHost" Spacing="8" />
                </StackPanel>
            </ScrollViewer>
        </Grid>


        <!-- ===== Pie: perfil aplicado a la izquierda (A abre la lista) y ayudas del mando a la derecha ===== -->
        <Grid x:Name="MonitorBar" Grid.Row="2" ColumnSpacing="8" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
                <StackPanel x:Name="GameBannerHost" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button x:Name="GameBanner" Style="{StaticResource RowButton}" Height="34" MaxWidth="170"
                            Padding="10,0,12,0" Click="OnBannerClick" AutomationProperties.Name="Perfil activo">
                        <FlyoutBase.AttachedFlyout>
                            <Flyout x:Name="ProfilesFlyout" Placement="TopEdgeAlignedLeft" FlyoutPresenterStyle="{StaticResource SelectorFlyoutStyle}">
                                <StackPanel x:Name="ProfilesFlyoutPanel" Spacing="2" />
                            </Flyout>
                        </FlyoutBase.AttachedFlyout>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock x:Name="GameIcon" Style="{StaticResource IconText}" FontSize="15" Text="&#xE288;" VerticalAlignment="Center" />
                            <TextBlock x:Name="GameTitle" Text="Global" FontSize="12.5" FontWeight="Bold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <!-- Sin uso visible: se mantienen para el aviso «Sin servicio» y temas -->
                            <TextBlock x:Name="GameSub" Visibility="Collapsed" />
                            <Border x:Name="ProfileChip" Visibility="Collapsed">
                                <TextBlock x:Name="ConnectionText" Text="PERFIL" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <!-- Solo con el autoguardado desactivado: guardar a mano en el perfil activo -->
                    <Button x:Name="SaveProfileButton" Style="{StaticResource RowButton}" Visibility="Collapsed"
                            Width="34" Height="34" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnSaveProfileClick"
                            AutomationProperties.Name="Guardar perfil" ToolTipService.ToolTip="Guardar los ajustes actuales en el perfil activo">
                        <TextBlock x:Name="SaveProfileIcon" Style="{StaticResource IconText}" FontSize="15" Text="&#xE248;" HorizontalAlignment="Center" />
                    </Button>
                </StackPanel>
            <!-- Ayudas del mando (cambian dentro de una subpágina) -->
            <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Height="34" CornerRadius="17" Padding="4,0" Background="{StaticResource Panel2Brush}">
                <StackPanel x:Name="HintsPanel" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="5" Margin="5,0">
                        <Border BorderBrush="White" BorderThickness="1.5" CornerRadius="9" Height="18" MinWidth="18" Padding="4,0">
                            <TextBlock Text="A" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Elegir" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel x:Name="HintTabs" Orientation="Horizontal" Spacing="5" Margin="5,0">
                        <Border BorderBrush="White" BorderThickness="1.5" CornerRadius="9" Height="18" MinWidth="18" Padding="4,0">
                            <TextBlock Text="LT RT" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Secciones" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel x:Name="HintBack" Orientation="Horizontal" Spacing="5" Margin="5,0" Visibility="Collapsed">
                        <Border BorderBrush="White" BorderThickness="1.5" CornerRadius="9" Height="18" MinWidth="18" Padding="4,0">
                            <TextBlock Text="B" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Volver" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
    </Grid>
</Page>

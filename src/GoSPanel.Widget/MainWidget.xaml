                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <TextBlock Style="{StaticResource IconText}" FontSize="14" Text="&#xE474;" />
                                                        <TextBlock Text="Reposo" FontSize="11.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock x:Name="ReactiveLowValue" Style="{StaticResource ValueText}" FontSize="12" />
                                                </Grid>
                                                <Slider x:Name="ReactiveLowSlider" Minimum="0" Maximum="60" StepFrequency="5" SmallChange="5"
                                                        ValueChanged="OnLightSliderChanged" AutomationProperties.Name="Brillo en reposo" />
                                            </StackPanel>
                                            <StackPanel Spacing="2">
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <TextBlock Style="{StaticResource IconText}" FontSize="14" Text="&#xE2DE;" />
                                                        <TextBlock Text="Pico con el sonido" FontSize="11.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock x:Name="ReactiveHighValue" Style="{StaticResource ValueText}" FontSize="12" />
                                                </Grid>
                                                <Slider x:Name="ReactiveHighSlider" Minimum="30" Maximum="100" StepFrequency="5" SmallChange="5"
                                                        ValueChanged="OnLightSliderChanged" AutomationProperties.Name="Brillo en los golpes" />
                                            </StackPanel>
                                        </StackPanel>
                                        <!-- Una sola columna: efecto, velocidad y colores (todos en una fila) -->
                                        <c:Selector x:Name="EffectSelector" Label="Efecto" SelectionChanged="OnEffectSelected" />
                                        <StackPanel x:Name="LightSpeedRow" Spacing="2">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <TextBlock Style="{StaticResource IconText}" FontSize="14" Text="&#xE492;" />
                                                    <TextBlock Text="Velocidad" FontSize="11.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock x:Name="LightSpeedValue" Style="{StaticResource ValueText}" FontSize="12" />
                                            </Grid>
                                            <Slider x:Name="LightSpeedSlider" Minimum="0" Maximum="100" StepFrequency="10" SmallChange="10"
                                                    ValueChanged="OnLightSliderChanged" AutomationProperties.Name="Velocidad del efecto" />
                                        </StackPanel>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Color" FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
                                            <VariableSizedWrapGrid x:Name="ColorSwatches" Orientation="Horizontal" MaximumRowsOrColumns="10"
                                                                   ItemWidth="30" ItemHeight="30" HorizontalAlignment="Center" />
                                        </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>





                            <!-- Instrucciones mientras se calibra -->
                            <StackPanel x:Name="CalibrationPanel" Spacing="8" Margin="0,10,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="CalibrationText" FontSize="12.5" TextWrapping="Wrap" />
                                <Button x:Name="CalibrationDoneButton" Style="{StaticResource ApplyButton}" Click="OnCalibrationDoneClick">
                                    <TextBlock Text="Terminar" FontSize="13" FontWeight="SemiBold" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- AJUSTES: ajustes (monitor, overlay, animaciones, carga), perfiles, comportamiento y acerca de -->
            <ScrollViewer x:Name="ProfilesPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <Border Style="{StaticResource SectionStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="AJUSTES" Style="{StaticResource SectionTitle}" />
                            <StackPanel Spacing="3">
                                <c:Tile Row="value" x:Name="ShowMonitorTile" Glyph="&#xE628;" Title="Datos del pie" State="—" Click="OnShowMonitorClick" />
                                <!-- Tarjeta: la fila y sus ajustes comparten fondo (se ve que van juntos) -->
                                <Border Background="{StaticResource Panel2Brush}" CornerRadius="8">
                                    <StackPanel>
                                        <c:Tile Row="value" x:Name="GameOverlayTile" Glyph="&#xE58C;" Title="Overlay en juegos" State="—" Click="OnOverlayCycleClick" />
                                        <StackPanel Spacing="8" x:Name="OverlaySettings" Margin="12,4,12,12" Visibility="Collapsed">
                                            <c:Selector x:Name="OverlayContentSelector" Label="Overlay · mostrar" SelectionChanged="OnOverlayContentSelected" />
                                            <c:Selector x:Name="OverlayPositionSelector" Label="Overlay · posición" SelectionChanged="OnOverlayPositionSelected" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <c:Tile Row="switch" x:Name="AnimationsTile" Glyph="&#xE6A2;" Title="Animaciones" State="—" Click="OnAnimationsClick" />
                                <c:Tile Row="switch" x:Name="ChargeTile" Glyph="&#xE808;" Title="Cargar solo hasta el 80 %" State="—" Click="OnChargeClick" />
                                <c:Tile Row="value" x:Name="ThemeTile" Glyph="&#xE6F0;" Title="Tema" State="—" Click="OnThemeClick" />
                                <c:Tile Row="switch" x:Name="SoundsTile" Glyph="&#xE44A;" Title="Sonidos" State="—" Click="OnSoundsClick" />
                            </StackPanel>
                            <TextBlock x:Name="BatteryHealthText" FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionStyle}">
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock Text="BOTONES LEGION" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="ButtonsHint" Style="{StaticResource SectionHint}" />
                            </Grid>
                            <!-- Se usan juntos: GoPilot atiende los botones y Legion Space debe estar desactivado para que no responda también -->
                            <StackPanel Spacing="3">
                                <!-- Tarjeta: el interruptor y las asignaciones de Legion L / R comparten fondo -->
                                <Border Background="{StaticResource Panel2Brush}" CornerRadius="8">
                                    <StackPanel>
                                        <c:Tile Row="switch" x:Name="ButtonsTile" Glyph="&#xE26E;" Title="Botones Legion con GoPilot" State="—" Click="OnButtonsToggleClick" />
                                        <StackPanel x:Name="ButtonsBody" Spacing="8" Margin="12,4,12,12">
                                            <TextBlock x:Name="ButtonsWarning" Visibility="Collapsed" FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}"
                                                       Text="Legion Space sigue activo y también responde a Legion L / R: desactívalo para que solo actúe GoPilot." />
                                            <Grid x:Name="ButtonsList" ColumnSpacing="8" RowSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <!-- Tarjeta: combinaciones Legion + botón (ocultas salvo que se abra) -->
                                <Border x:Name="AdvancedButtonsCard" Background="{StaticResource Panel2Brush}" CornerRadius="8">
                                    <StackPanel>
                                        <c:Tile Row="sub" x:Name="AdvancedButtonsTile" Glyph="&#xE272;" Title="Atajos avanzados" State="—" Click="OnAdvancedButtonsClick" />
                                        <Grid x:Name="AdvancedButtonsList" ColumnSpacing="8" RowSpacing="8" Margin="12,4,12,12" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <c:Tile Row="switch" x:Name="LegionSpaceTile" Glyph="&#xE6A2;" Title="Legion Space" State="—" Available="False" Click="OnLegionSpaceClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionStyle}">
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock Text="PERFILES" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="ProfileCountText" Style="{StaticResource SectionHint}" />
                            </Grid>
                            <c:Tile Row="switch" x:Name="AutoProfilesTile" Glyph="&#xE036;" Title="Aplicar perfiles automáticamente" State="—" Click="OnAutoProfilesClick" />
                            <c:Tile Row="switch" x:Name="AutoSaveTile" Glyph="&#xE248;" Title="Guardar cambios automáticamente" State="—" Click="OnAutoSaveClick" />
                            <StackPanel x:Name="ProfilesList" Spacing="6" />
                            <TextBlock x:Name="ProfilesEmptyText" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                       Text="Abre un juego, ajusta modo, TDP, pantalla y Lossless a tu gusto y pulsa el disquete del banner. La próxima vez se aplicará solo y, al cerrar el juego, volverás a Global." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="COMPORTAMIENTO" Style="{StaticResource SectionTitle}" />
                            <c:Tile Row="switch" x:Name="ResumeTile" Glyph="&#xE036;" Title="Reaplicar ajustes tras suspender" State="—" Click="OnResumeClick" />
                            <c:Selector x:Name="RefreshRateSelector" Label="Actualizar datos cada" SelectionChanged="OnRefreshRateSelected" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="UpdatesSection" Style="{StaticResource SectionStyle}">
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock Text="ACTUALIZACIONES" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="UpdateHint" Style="{StaticResource SectionHint}" />
                            </Grid>
                            <StackPanel Spacing="3">
                                <!-- Tarjeta: la fila de la versión y, si hay una nueva, sus novedades y botones -->
                                <Border Background="{StaticResource Panel2Brush}" CornerRadius="8">
                                    <StackPanel>
                                        <c:Tile Row="value" x:Name="UpdateTile" Glyph="&#xE184;" Title="GoPilot" State="—" Click="OnUpdateTileClick" />
                                        <StackPanel x:Name="UpdateBody" Spacing="8" Margin="12,4,12,12" Visibility="Collapsed">
                                            <Border x:Name="UpdateNotesBox" Background="{StaticResource Panel3Brush}" CornerRadius="6" Padding="10,8">
                                                <TextBlock x:Name="UpdateNotes" FontSize="11.5" TextWrapping="Wrap" />
                                            </Border>
                                            <ProgressBar x:Name="UpdateProgress" Maximum="100" Height="4" Foreground="{StaticResource AccentBrush}" Visibility="Collapsed" />
                                            <TextBlock x:Name="UpdateMessage" FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Visibility="Collapsed" />
                                            <Grid x:Name="UpdateButtons" ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="UpdateNowButton" Style="{StaticResource ApplyButton}" Height="34" Content="Actualizar" Click="OnUpdateNowClick" />
                                                <Button x:Name="UpdateLaterButton" Grid.Column="1" Style="{StaticResource FlatButton}" Background="{StaticResource Panel3Brush}" Height="34"
                                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnUpdateLaterClick">
                                                    <TextBlock Text="Más tarde" FontSize="13" FontWeight="SemiBold" />
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <c:Tile Row="switch" x:Name="AutoUpdateTile" Glyph="&#xE094;" Title="Buscar automáticamente" State="—" Click="OnAutoUpdateClick" />
                                <c:Tile Row="value" x:Name="UninstallTile" Glyph="&#xE4A6;" Title="Desinstalar GoPilot" State="" Click="OnUninstallClick" />
                            </StackPanel>
                            <TextBlock x:Name="AboutText" FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="11.5" IsTextSelectionEnabled="True"
                                       Foreground="{StaticResource MutedBrush}" MaxLines="12" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>


        <!-- ===== Pie («dock»): franja propia de borde a borde, más oscura, para que no se confunda con el contenido.
             A la izquierda el perfil aplicado (la lista se abre hacia arriba); a la derecha FPS, temperatura, consumo
             real de la APU y ventilador. Las pestañas de arriba ya no cambian de sitio con el nombre del perfil. ===== -->
        <Grid x:Name="MonitorBar" Grid.Row="2" Background="{StaticResource DockBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
              Margin="-10,0,-10,-10" Padding="10,7,10,9" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
                <StackPanel x:Name="GameBannerHost" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button x:Name="GameBanner" Style="{StaticResource FlatButton}" Background="{StaticResource Panel3Brush}" Height="32" MaxWidth="170"
                            Padding="8,0" Click="OnBannerClick" AutomationProperties.Name="Perfil activo">
                        <FlyoutBase.AttachedFlyout>
                            <Flyout x:Name="ProfilesFlyout" Placement="TopEdgeAlignedLeft" FlyoutPresenterStyle="{StaticResource SelectorFlyoutStyle}">
                                <StackPanel x:Name="ProfilesFlyoutPanel" Spacing="2" />
                            </Flyout>
                        </FlyoutBase.AttachedFlyout>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock x:Name="GameIcon" Style="{StaticResource IconText}" FontSize="14" Text="&#xE560;" VerticalAlignment="Center" />
                            <TextBlock x:Name="GameTitle" Text="Global" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource IconText}" FontSize="10" Text="&#xE13C;" VerticalAlignment="Center" Margin="2,0,0,0" />
                            <!-- Sin uso visible: se mantienen para el aviso «Sin servicio» y temas -->
                            <TextBlock x:Name="GameSub" Visibility="Collapsed" />
                            <Border x:Name="ProfileChip" Visibility="Collapsed">
                                <TextBlock x:Name="ConnectionText" Text="PERFIL" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <!-- Solo con el autoguardado desactivado: guardar a mano en el perfil activo -->
                    <Button x:Name="SaveProfileButton" Style="{StaticResource FlatButton}" Background="{StaticResource Panel3Brush}" Visibility="Collapsed"
                            Width="30" Height="30" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnSaveProfileClick"
                            AutomationProperties.Name="Guardar perfil" ToolTipService.ToolTip="Guardar los ajustes actuales en el perfil activo">
                        <TextBlock x:Name="SaveProfileIcon" Style="{StaticResource IconText}" FontSize="15" Text="&#xE248;" HorizontalAlignment="Center" />
                    </Button>
                </StackPanel>
            <StackPanel x:Name="FooterStats" Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel x:Name="FpsItem" Orientation="Horizontal" Spacing="2">
                    <TextBlock x:Name="FpsValue" Text="—" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource OkBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="FPS" FontSize="10.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="TempValue" Text="—" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <TextBlock x:Name="PowerValue" Text="—" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="W" FontSize="10.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="3">
                    <TextBlock Style="{StaticResource IconText}" FontSize="13" Text="&#xE9F2;" />
                    <TextBlock x:Name="FanValue" Text="—" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Grid>

    </Grid>
    </Grid>
</Page>

<UserControl
    x:Class="GoSPanel.Widget.Controls.Selector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">

    <StackPanel Spacing="4">
        <TextBlock x:Name="LabelText" FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
        <Button x:Name="Root" Style="{StaticResource FlatButton}" Background="{StaticResource Panel3Brush}"
                BorderBrush="{StaticResource LineBrush}" Height="36" Padding="10,0" Click="OnRootClick">
            <Grid>
                <TextBlock x:Name="ValueText" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="0,0,20,0" />
                <TextBlock Style="{StaticResource IconText}" FontSize="12" Text="&#xE136;" HorizontalAlignment="Right" />
            </Grid>
            <FlyoutBase.AttachedFlyout>
                <Flyout x:Name="OptionsFlyout" Placement="Bottom" FlyoutPresenterStyle="{StaticResource SelectorFlyoutStyle}">
                    <StackPanel x:Name="OptionsPanel" Spacing="2" />
                </Flyout>
            </FlyoutBase.AttachedFlyout>
        </Button>
    </StackPanel>
</UserControl>

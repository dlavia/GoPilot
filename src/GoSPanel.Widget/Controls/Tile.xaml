<UserControl
    x:Class="GoSPanel.Widget.Controls.Tile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">

    <Button x:Name="Root" Style="{StaticResource FlatButton}" Click="OnRootClick"
            Background="{StaticResource Panel2Brush}">
        <Grid x:Name="Layout" ColumnSpacing="8" RowSpacing="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="IconText" FontFamily="{StaticResource Phosphor}" FontSize="20"
                       Foreground="{StaticResource IconBrush}" />
            <TextBlock x:Name="TitleText" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="StateText" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
            <Border x:Name="BadgeBorder" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5"
                    Padding="6,2" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="BadgeText" FontSize="10.5" Foreground="{StaticResource MutedBrush}" />
            </Border>
            <!-- Modo fila: interruptor o › a la derecha -->
            <Border x:Name="SwitchTrack" Grid.Column="3" Width="32" Height="18" CornerRadius="9" VerticalAlignment="Center" Visibility="Collapsed">
                <Ellipse x:Name="SwitchKnob" Width="12" Height="12" Margin="3,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
            </Border>
            <TextBlock x:Name="ChevronText" Grid.Column="3" FontFamily="{StaticResource Phosphor}" FontSize="12" Text="&#xE13A;"
                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Visibility="Collapsed" />
        </Grid>
    </Button>
</UserControl>

<Application
    x:Class="GoSPanel.Widget.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <!-- Paleta (igual que design/widget-preview.html) -->
        <Color x:Key="AccentColor">#FFFF2B45</Color>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#38FF2B45" />
        <!-- Acento más claro (AccentLight2 de Windows): icono de la pestaña activa, que destaque sobre el fondo oscuro -->
        <SolidColorBrush x:Key="AccentLightBrush" Color="#FFFF7A8A" />
        <!-- Sobre el fondo de Game Bar (el widget no pinta fondo propio). Como en los widgets de Xbox, las tarjetas
             y los controles son MÁS OSCUROS que el fondo y llevan un borde fino claro para destacar. -->
        <SolidColorBrush x:Key="PageBrush" Color="#00000000" />
        <SolidColorBrush x:Key="PanelBrush" Color="#1F000000" />
        <SolidColorBrush x:Key="Panel2Brush" Color="#C73C3C3C" />
        <!-- Fila con el foco (menú de Legion L): más clara, con aro blanco -->
        <SolidColorBrush x:Key="RowFocusBrush" Color="#E6585858" />
        <!-- Nombre de las filas sin foco: algo apagado; con foco, blanco -->
        <SolidColorBrush x:Key="RowTextBrush" Color="#FFC4C4C8" />
        <SolidColorBrush x:Key="Panel3Brush" Color="#1FFFFFFF" />
        <!-- Pie («dock»): más oscuro que las filas para que la pastilla del perfil no se confunda con ellas -->
        <SolidColorBrush x:Key="DockBrush" Color="#73000000" />
        <SolidColorBrush x:Key="LineBrush" Color="#2EFFFFFF" />
        <SolidColorBrush x:Key="TrackBrush" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="TextBrush" Color="#FFF3F3F5" />
        <SolidColorBrush x:Key="MutedBrush" Color="#FF9B9BA5" />
        <SolidColorBrush x:Key="IconBrush" Color="#FFC9C9D1" />
        <SolidColorBrush x:Key="OkBrush" Color="#FF3DDC84" />
        <SolidColorBrush x:Key="WarnBrush" Color="#FFFFB020" />

        <!-- Acento también para los controles del sistema (sliders, combos, foco) -->
        <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="{StaticResource AccentColor}" />
        <!-- Barras blancas, como el menú de Legion L -->
        <SolidColorBrush x:Key="SliderTrackValueFill" Color="White" />
        <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="White" />
        <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="White" />
        <SolidColorBrush x:Key="SliderTrackFill" Color="#29FFFFFF" />
        <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="SliderThumbBackground" Color="White" />
        <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="White" />
        <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="White" />
        <!-- Deslizador como el de la maqueta (menú de Legion L): pista fina gris y relleno blanco con los extremos
             redondeados, sin el pulgar redondo del de Windows / Game Bar. Estilo implícito: vale para todos los Slider.
             El valor se cambia con ◀ ▶ (OnSliderPreviewKeyDown) o tocando y arrastrando en la pista. Las piezas con
             nombre (HorizontalTrackRect, HorizontalDecreaseRect, HorizontalThumb…) las usa el Slider para pintar el
             relleno; el pulgar queda con ancho 0 e invisible para que el relleno llegue hasta el final. -->
        <Style TargetType="Slider">
            <Setter Property="Background" Value="#29FFFFFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="IsThumbToolTipEnabled" Value="False" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid x:Name="SliderContainer" Background="Transparent" Margin="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver" />
                                    <VisualState x:Name="Pressed" />
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="SliderContainer.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid x:Name="HorizontalTemplate" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Rectangle x:Name="HorizontalTrackRect" Grid.ColumnSpan="3" Height="8" RadiusX="4" RadiusY="4" Fill="{TemplateBinding Background}" />
                                <Rectangle x:Name="HorizontalDecreaseRect" Height="8" RadiusX="4" RadiusY="4" Fill="{TemplateBinding Foreground}" />
                                <Thumb x:Name="HorizontalThumb" Grid.Column="1" Width="0" Height="8" Opacity="0"
                                       DataContext="{TemplateBinding Value}" AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                            <Grid x:Name="VerticalTemplate" Visibility="Collapsed" HorizontalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Rectangle x:Name="VerticalTrackRect" Grid.RowSpan="3" Width="8" RadiusX="4" RadiusY="4" Fill="{TemplateBinding Background}" />
                                <Rectangle x:Name="VerticalDecreaseRect" Grid.Row="2" Width="8" RadiusX="4" RadiusY="4" Fill="{TemplateBinding Foreground}" />
                                <Thumb x:Name="VerticalThumb" Grid.Row="1" Width="8" Height="0" Opacity="0"
                                       DataContext="{TemplateBinding Value}" AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <SolidColorBrush x:Key="ComboBoxBackground" Color="#4D000000" />
        <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#2EFFFFFF" />

        <FontFamily x:Key="Phosphor">ms-appx:///Assets/Fonts/GoPilotIcons.ttf#GoPilotIcons</FontFamily>

        <Style x:Key="SectionStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CharacterSpacing" Value="40" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style x:Key="SectionHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Phosphor}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <!-- Botón plano: el aspecto lo pone el contenido; mantiene foco de sistema para el mando -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualPrimaryBrush" Value="White" />
            <Setter Property="FocusVisualPrimaryThickness" Value="2" />
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent" />
            <Setter Property="FocusVisualSecondaryThickness" Value="0" />
            <Setter Property="FocusVisualMargin" Value="-3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="Scale" />
                            </Grid.RenderTransform>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Hover.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Hover.Opacity" Value="1" />
                                            <Setter Target="Scale.ScaleX" Value="0.97" />
                                            <Setter Target="Scale.ScaleY" Value="0.97" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.45" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" />
                            <Border x:Name="Hover" Background="#0FFFFFFF" CornerRadius="8" Opacity="0" />
                            <ContentPresenter Padding="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fila (menú de Legion L): tarjeta redondeada; el foco es un aro blanco por fuera (foco de sistema) -->
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Panel2Brush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualPrimaryBrush" Value="White" />
            <Setter Property="FocusVisualPrimaryThickness" Value="2" />
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent" />
            <Setter Property="FocusVisualSecondaryThickness" Value="0" />
            <Setter Property="FocusVisualMargin" Value="-3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="Scale" />
                            </Grid.RenderTransform>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Hover.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Hover.Opacity" Value="1" />
                                            <Setter Target="Scale.ScaleX" Value="0.98" />
                                            <Setter Target="Scale.ScaleY" Value="0.98" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.45" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" />
                            <Border x:Name="Hover" Background="#0FFFFFFF" CornerRadius="14" Opacity="0" />
                            <ContentPresenter Padding="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Título de grupo («RENDIMIENTO», «AMD RADEON»…) entre filas -->
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="80" />
            <Setter Property="Foreground" Value="#66F5F5F7" />
            <Setter Property="Margin" Value="6,12,6,0" />
        </Style>

        <!-- Lista flotante del selector: oscura, redondeada y con borde fino, como el resto del widget -->
        <Style x:Key="SelectorFlyoutStyle" TargetType="FlyoutPresenter">
            <Setter Property="Background" Value="#F01C1C20" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MaxHeight" Value="480" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style x:Key="ApplyButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Application.Resources>
</Application>
